{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "targetCommit", "checks", "artifacts", "blockers", "decisionState", "communicationState"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "targetCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyEvidenceItem" } },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyEvidenceItem" } },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "owner", "state"],
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "state": { "enum": ["open", "resolved", "accepted"] }
            }
          }
        },
        "decisionState": { "enum": ["not-ready", "ready-for-owner-decision", "approved", "released"] },
        "communicationState": { "enum": ["not-drafted", "draft", "approved", "sent"] }
      }
    },
    {
      "type": "object",
      "required": ["schemaVersion", "release", "principals", "requiredChecks", "artifacts", "evidence", "blockers", "waivers", "rollback", "limitations", "recommendation", "owner", "ownerId", "handoff"],
      "properties": {
        "schemaVersion": { "const": "awesomeClaws.releaseReadiness.v1" },
        "release": { "type": "object" },
        "principals": { "type": "array" },
        "requiredChecks": { "type": "array" },
        "artifacts": { "type": "array" },
        "evidence": { "type": "array" },
        "blockers": { "type": "array" },
        "waivers": { "type": "array" },
        "rollback": { "type": "object" },
        "limitations": { "type": "array" },
        "recommendation": { "type": ["object", "null"] },
        "owner": { "type": "string" },
        "ownerId": { "type": "string" },
        "handoff": { "type": "object" }
      },
      "not": { "required": ["checks"] }
    }
  ],
  "$defs": {
    "legacyEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "enum": ["passed", "failed", "blocked", "missing", "waived"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
