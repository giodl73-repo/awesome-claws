{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/meal-grocery.schema.json",
  "title": "Meal and grocery planner artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources",
    "constraints",
    "inventory",
    "meals",
    "groceryItems",
    "reviewQuestions",
    "blockedActions",
    "handoff"
  ],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.mealGrocery.v1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["recipe", "pantry-note", "fridge-note", "freezer-note", "receipt", "store-page", "circular", "coupon", "owner-note", "dietary-note", "allergy-note", "care-scope"] },
          "authority": { "enum": ["owner", "household", "care-recipient", "store", "recipe-publisher", "receipt", "unknown"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "recent", "stale", "unknown", "conflicting"] },
          "privacy": { "enum": ["normal", "private", "address-sensitive", "medical-sensitive", "allergy-sensitive", "dietary-sensitive", "budget-sensitive", "household-sensitive", "care-sensitive"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "required", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["dietary", "allergy", "budget", "prep-time", "servings", "equipment", "leftovers", "use-first", "avoid", "preference", "transport", "privacy"] },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "privacy": { "enum": ["normal", "private", "medical-sensitive", "allergy-sensitive", "dietary-sensitive", "budget-sensitive", "household-sensitive", "care-sensitive"] },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "location", "quantityState", "freshnessState", "usePriority", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "location": { "enum": ["pantry", "fridge", "freezer", "unknown"] },
          "quantityState": { "enum": ["supported", "estimated", "unknown", "conflicting"] },
          "freshnessState": { "enum": ["current", "use-soon", "expired-risk", "unknown", "conflicting"] },
          "usePriority": { "enum": ["use-first", "normal", "avoid", "unknown"] },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mealSlot", "recipeRefs", "constraintRefs", "inventoryRefs", "groceryRefs", "fitState", "sourceRefs", "blockedReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "mealSlot": { "type": "string", "minLength": 1 },
          "recipeRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "constraintRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "inventoryRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "groceryRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "fitState": { "enum": ["ready-for-review", "possible", "blocked", "unknown", "conflicting"] },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "blockedReason": { "type": "string" }
        }
      }
    },
    "groceryItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "neededForMealRefs", "quantityState", "priceState", "availabilityState", "sourceRefs", "substitutionRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["produce", "protein", "grain", "dairy", "frozen", "pantry", "spice", "beverage", "household", "other"] },
          "neededForMealRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "quantityState": { "enum": ["supported", "estimated", "unknown", "conflicting"] },
          "priceState": { "enum": ["supported", "estimated", "unknown", "conflicting"] },
          "availabilityState": { "enum": ["in-stock", "possible", "unknown", "out-of-stock", "conflicting"] },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "substitutionRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "refs", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "reason": { "type": "string", "minLength": 1 },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "owner": { "enum": ["owner", "household", "care-recipient", "medical-professional", "store", "unknown"] }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["order-groceries", "checkout-cart", "schedule-delivery", "modify-subscription", "edit-calendar", "message-household", "share-address", "publish-list", "claim-allergen-certainty", "give-medical-diet-advice", "discard-food"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary", "reviewQuestionRefs", "prohibitedActions", "nextOwner"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked-on-evidence", "blocked-on-approval"] },
        "summary": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "prohibitedActions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["order-groceries", "checkout-cart", "schedule-delivery", "modify-subscription", "edit-calendar", "message-household", "share-address", "publish-list", "claim-allergen-certainty", "give-medical-diet-advice", "discard-food"] }
        },
        "nextOwner": { "enum": ["owner", "household", "care-recipient", "medical-professional", "store"] }
      }
    }
  }
}
