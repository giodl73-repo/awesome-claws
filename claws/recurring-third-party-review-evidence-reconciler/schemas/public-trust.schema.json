{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.recurringThirdPartyReviewEvidenceReconcilerPublicTrust.v1"
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/signer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRef",
        "signingKeyId",
        "algorithm",
        "publicKeyPem",
        "validFrom",
        "validUntil"
      ],
      "properties": {
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "signingKeyId": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "publicKeyPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\r?\\n[A-Za-z0-9+/=\\r\\n]+-----END PUBLIC KEY-----\\r?\\n?$",
          "maxLength": 4096
        },
        "validFrom": {
          "$ref": "#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
