{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerRef",
    "signingKeyId",
    "issuedAt",
    "receipts",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.recurringThirdPartyReviewSourceReceipts.v1"
    },
    "ownerRef": {
      "$ref": "#/$defs/id"
    },
    "signingKeyId": {
      "$ref": "#/$defs/id"
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "receipts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^controlled://[^\\s]+$",
          "maxLength": 500
        },
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 500
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "sourceRef",
        "sourceVersion",
        "contentBase64",
        "contentDigest"
      ],
      "properties": {
        "evidenceRef": {
          "$ref": "#/$defs/id"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "contentBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 131072
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
