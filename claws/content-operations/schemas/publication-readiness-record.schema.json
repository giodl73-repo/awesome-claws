{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/publication-readiness-record.schema.json",
  "title": "Content publication readiness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "brief",
    "sources",
    "claims",
    "assets",
    "approvals",
    "metrics",
    "reviewQuestions",
    "prohibitedActions",
    "handoff"
  ],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.publicationReadinessRecord.v1" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request",
        "owner",
        "ownerType",
        "channelOwner",
        "channelOwnerType",
        "asOf",
        "deadline",
        "timeZone",
        "state"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^package-[a-z0-9-]+$" },
        "request": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/principal" },
        "ownerType": { "$ref": "#/$defs/principalType" },
        "channelOwner": { "$ref": "#/$defs/principal" },
        "channelOwnerType": { "$ref": "#/$defs/principalType" },
        "asOf": { "type": "string", "format": "date-time" },
        "deadline": { "type": "string", "format": "date-time" },
        "timeZone": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["blocked", "ready-for-owner-review", "ready-for-publication"]
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "channels",
        "intendedAction",
        "successMeasure",
        "voice",
        "restrictedTopics",
        "acceptanceCriteria"
      ],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/channel" }
        },
        "intendedAction": { "type": "string", "minLength": 1 },
        "successMeasure": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "restrictedTopics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "state", "assetRefs"],
            "properties": {
              "id": { "type": "string", "pattern": "^criterion-[a-z0-9-]+$" },
              "statement": { "type": "string", "minLength": 1 },
              "state": { "enum": ["met", "not-met", "review-needed"] },
              "assetRefs": { "$ref": "#/$defs/assetRefs" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "reference",
          "observedAt",
          "freshness",
          "classification"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
          "kind": {
            "enum": [
              "product-brief",
              "approved-fact",
              "customer-quote-consent",
              "brand-guidance",
              "legal-guidance",
              "executive-direction",
              "channel-guidance",
              "measurement-plan",
              "asset"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "freshness": { "enum": ["current", "stale", "missing", "conflicting"] },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "sourceRefs",
          "allowedChannels",
          "requiredApprovalKinds",
          "restrictions",
          "state"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
          "kind": {
            "enum": [
              "product-capability",
              "performance",
              "customer-quote",
              "legal-or-regulatory",
              "executive-position",
              "general-fact"
            ]
          },
          "statement": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
          "allowedChannels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/channel" }
          },
          "requiredApprovalKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/approvalKind" }
          },
          "restrictions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "state": { "enum": ["supported", "review-needed", "blocked"] }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "path",
          "channel",
          "version",
          "claimRefs",
          "criterionRefs",
          "state",
          "publicationState"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" },
          "kind": { "enum": ["article", "announcement", "email", "social", "documentation", "visual", "internal-brief"] },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "channel": { "$ref": "#/$defs/channel" },
          "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
          "claimRefs": { "$ref": "#/$defs/claimRefs" },
          "criterionRefs": { "$ref": "#/$defs/criterionRefs" },
          "state": { "enum": ["draft", "review-needed", "ready-for-owner-review", "approved"] },
          "publicationState": { "const": "not-published" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reviewer",
          "reviewerType",
          "assetRef",
          "assetVersion",
          "claimRefs",
          "evidenceSourceRefs",
          "decision",
          "decidedAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^approval-[a-z0-9-]+$" },
          "kind": { "$ref": "#/$defs/approvalKind" },
          "reviewer": { "$ref": "#/$defs/principal" },
          "reviewerType": { "$ref": "#/$defs/principalType" },
          "assetRef": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" },
          "assetVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
          "claimRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" }
          },
          "evidenceSourceRefs": { "$ref": "#/$defs/sourceRefs" },
          "decision": { "enum": ["pending", "approved", "changes-requested", "rejected"] },
          "decidedAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition", "owner", "ownerType", "sourceRefs", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^metric-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "owner": { "$ref": "#/$defs/principal" },
          "ownerType": { "$ref": "#/$defs/principalType" },
          "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
          "state": { "enum": ["defined", "review-needed", "blocked"] }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "owner", "ownerType", "refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "owner": { "$ref": "#/$defs/principal" },
          "ownerType": { "$ref": "#/$defs/principalType" },
          "refs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "prohibitedActions": { "$ref": "#/$defs/prohibitedActions" },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner",
        "ownerType",
        "channelOwner",
        "channelOwnerType",
        "sourceRefs",
        "claimRefs",
        "assetRefs",
        "approvalRefs",
        "metricRefs",
        "criterionRefs",
        "reviewQuestionRefs",
        "blockingRefs",
        "prohibitedActions"
      ],
      "properties": {
        "state": { "enum": ["blocked", "ready-for-owner-review", "ready-for-publication"] },
        "owner": { "$ref": "#/$defs/principal" },
        "ownerType": { "$ref": "#/$defs/principalType" },
        "channelOwner": { "$ref": "#/$defs/principal" },
        "channelOwnerType": { "$ref": "#/$defs/principalType" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "claimRefs": { "$ref": "#/$defs/claimRefs" },
        "assetRefs": { "$ref": "#/$defs/assetRefs" },
        "approvalRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^approval-[a-z0-9-]+$" }
        },
        "metricRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^metric-[a-z0-9-]+$" }
        },
        "criterionRefs": { "$ref": "#/$defs/criterionRefs" },
        "reviewQuestionRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" }
        },
        "blockingRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedActions": { "$ref": "#/$defs/prohibitedActions" }
      }
    }
  },
  "$defs": {
    "principal": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "principalType": { "enum": ["human", "team"] },
    "channel": { "enum": ["web", "email", "social", "documentation", "press", "internal"] },
    "approvalKind": { "enum": ["factual", "brand", "legal", "executive", "channel-owner"] },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" }
    },
    "claimRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" }
    },
    "assetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" }
    },
    "criterionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^criterion-[a-z0-9-]+$" }
    },
    "prohibitedActions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "publish-content",
          "schedule-content",
          "distribute-content",
          "mutate-cms",
          "message-audience",
          "represent-approval",
          "claim-measured-results"
        ]
      }
    }
  }
}
