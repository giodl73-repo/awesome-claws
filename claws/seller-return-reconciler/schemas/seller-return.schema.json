{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplied seller return reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "report"],
  "properties": {
    "input": { "$ref": "#/$defs/input" },
    "report": { "$ref": "#/$defs/report" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "time": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "quantity": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "principal": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["human", "automation", "unknown"] } }
    },
    "nullablePrincipal": { "anyOf": [{ "$ref": "#/$defs/principal" }, { "type": "null" }] },
    "holds": { "type": "array", "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "sources", "lines", "receipts", "dispositions"],
      "properties": {
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["batchId", "revision", "asOf", "owner"],
          "properties": { "batchId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/id" }, "asOf": { "$ref": "#/$defs/time" }, "owner": { "$ref": "#/$defs/principal" } }
        },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "revision", "capturedAt"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/id" }, "capturedAt": { "$ref": "#/$defs/time" } }
          }
        },
        "lines": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "returnId", "returnLine", "product", "unit", "authorizedQuantity", "authorized", "authorizedBy", "authorizedAt", "holds", "sourceRef", "sourceRevision", "sourceRecord"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "returnId": { "$ref": "#/$defs/id" }, "returnLine": { "$ref": "#/$defs/id" },
              "product": { "$ref": "#/$defs/id" }, "unit": { "$ref": "#/$defs/id" }, "authorizedQuantity": { "$ref": "#/$defs/quantity" },
              "authorized": { "type": "boolean" }, "authorizedBy": { "$ref": "#/$defs/nullablePrincipal" }, "authorizedAt": { "$ref": "#/$defs/time" },
              "holds": { "$ref": "#/$defs/holds" }, "sourceRef": { "$ref": "#/$defs/id" }, "sourceRevision": { "$ref": "#/$defs/id" }, "sourceRecord": { "$ref": "#/$defs/id" }
            }
          }
        },
        "receipts": {
          "type": "array", "maxItems": 3000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "lineId", "receivingId", "lotId", "product", "unit", "quantity", "status", "replacedBy", "receivedAt", "sourceRef", "sourceRevision", "sourceRecord"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "lineId": { "$ref": "#/$defs/id" }, "receivingId": { "$ref": "#/$defs/id" }, "lotId": { "$ref": "#/$defs/id" },
              "product": { "$ref": "#/$defs/id" }, "unit": { "$ref": "#/$defs/id" }, "quantity": { "$ref": "#/$defs/positive" },
              "status": { "enum": ["received", "void", "superseded"] }, "replacedBy": { "$ref": "#/$defs/nullableId" }, "receivedAt": { "$ref": "#/$defs/time" },
              "sourceRef": { "$ref": "#/$defs/id" }, "sourceRevision": { "$ref": "#/$defs/id" }, "sourceRecord": { "$ref": "#/$defs/id" }
            }
          }
        },
        "dispositions": {
          "type": "array", "maxItems": 3000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "receiptId", "unitRanges", "decision", "decidedBy", "decidedAt", "status", "replacedBy", "sourceRef", "sourceRevision", "sourceRecord"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "receiptId": { "$ref": "#/$defs/id" },
              "unitRanges": {
                "type": "array", "minItems": 1, "maxItems": 100,
                "items": { "type": "object", "additionalProperties": false, "required": ["first", "last"], "properties": { "first": { "$ref": "#/$defs/positive" }, "last": { "$ref": "#/$defs/positive" } } }
              },
              "decision": { "enum": ["repair", "replace", "return-to-stock", "scrap", "hold", "other"] },
              "decidedBy": { "$ref": "#/$defs/nullablePrincipal" }, "decidedAt": { "$ref": "#/$defs/time" },
              "status": { "enum": ["recorded", "void", "superseded"] }, "replacedBy": { "$ref": "#/$defs/nullableId" },
              "sourceRef": { "$ref": "#/$defs/id" }, "sourceRevision": { "$ref": "#/$defs/id" }, "sourceRecord": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "inputDigest", "status", "owner", "asOf", "approved", "externalActionsPerformed", "balances", "exceptions", "coverage"],
      "properties": {
        "schemaVersion": { "const": "awesomeClaws.sellerReturnReport.v1" }, "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["draft", "blocked"] }, "owner": { "$ref": "#/$defs/principal" }, "asOf": { "$ref": "#/$defs/time" },
        "approved": { "const": false }, "externalActionsPerformed": { "const": false },
        "balances": {
          "type": "array", "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["lineId", "authorized", "received", "dispositionEvidenced", "notEvidencedReceived", "awaitingDisposition", "holds", "dispositionHolds", "status"],
            "properties": {
              "lineId": { "$ref": "#/$defs/id" }, "authorized": { "$ref": "#/$defs/quantity" }, "received": { "$ref": "#/$defs/quantity" },
              "dispositionEvidenced": { "$ref": "#/$defs/quantity" }, "notEvidencedReceived": { "$ref": "#/$defs/quantity" }, "awaitingDisposition": { "$ref": "#/$defs/quantity" },
              "holds": { "$ref": "#/$defs/holds" }, "dispositionHolds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "status": { "enum": ["open", "held", "quantity-evidenced"] }
            }
          }
        },
        "exceptions": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["code", "recordId", "message"],
            "properties": { "code": { "$ref": "#/$defs/id" }, "recordId": { "$ref": "#/$defs/id" }, "message": { "$ref": "#/$defs/text" } }
          }
        },
        "coverage": {
          "type": "object", "additionalProperties": false, "required": ["lines", "receipts", "dispositions"],
          "properties": {
            "lines": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "receipts": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "dispositions": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        }
      }
    }
  }
}
