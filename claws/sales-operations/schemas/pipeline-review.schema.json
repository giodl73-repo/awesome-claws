{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewPeriod", "asOf", "currency", "snapshot", "deals", "changes", "risks", "actions", "decisionOwner", "decisionState"],
  "properties": {
    "reviewPeriod": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "observedAt"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "deals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "forecastCategory", "amount", "lastActivityAt", "owner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "forecastCategory": { "type": "string", "minLength": 1 },
          "amount": { "type": "number", "minimum": 0 },
          "lastActivityAt": { "type": "string", "format": "date-time" },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dealRef", "field", "from", "to", "evidence"],
        "properties": {
          "dealRef": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dealRefs", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "dealRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dealRefs", "owner", "dueAt", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "dealRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 },
          "dueAt": { "type": "string", "format": "date-time" },
          "state": { "enum": ["proposed", "approved-by-owner", "completed-by-owner"] }
        }
      }
    },
    "decisionOwner": { "type": "string", "minLength": 1 },
    "decisionState": { "enum": ["draft", "ready-for-owner-review", "approved-by-owner", "completed-by-owner"] }
  }
}
