{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "frameworkVersion", "systemBoundary", "reviewPeriod", "requirements", "remediation", "assessmentDecision"],
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "frameworkVersion": { "type": "string", "minLength": 1 },
        "systemBoundary": { "type": "string", "minLength": 1 },
        "reviewPeriod": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyRequirement" } },
        "remediation": { "type": "array", "items": { "$ref": "#/$defs/legacyRemediation" } },
        "assessmentDecision": { "enum": ["not-reviewable", "needs-remediation", "ready-for-independent-review"] }
      }
    },
    {
      "type": "object",
      "required": ["schemaVersion", "review", "principals", "requirements", "evidence", "findings", "compensatingControls", "remediation", "verifications", "limitations", "recommendation", "owner", "ownerId", "handoff"],
      "properties": {
        "schemaVersion": { "const": "awesomeClaws.controlAssessment.v1" },
        "review": { "type": "object" },
        "principals": { "type": "array" },
        "requirements": { "type": "array" },
        "evidence": { "type": "array" },
        "findings": { "type": "array" },
        "compensatingControls": { "type": "array" },
        "remediation": { "type": "array" },
        "verifications": { "type": "array" },
        "limitations": { "type": "array" },
        "recommendation": { "type": ["object", "null"] },
        "owner": { "type": "string" },
        "ownerId": { "type": "string" },
        "handoff": { "type": "object" }
      },
      "not": { "required": ["framework"] }
    }
  ],
  "$defs": {
    "legacyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "requirement", "controlOwner", "implementationState", "evidenceState", "evidence", "finding"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "controlOwner": { "type": "string", "minLength": 1 },
        "implementationState": { "enum": ["implemented", "partial", "not-implemented", "not-applicable"] },
        "evidenceState": { "enum": ["supported", "unsupported", "stale", "conflicting", "compensating-control"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyEvidence" } },
        "compensatingControl": { "$ref": "#/$defs/legacyCompensatingControl" },
        "finding": { "$ref": "#/$defs/legacyFinding" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "evidenceState": { "const": "compensating-control" } },
            "required": ["evidenceState"]
          },
          "then": { "type": "object", "required": ["compensatingControl"], "properties": { "compensatingControl": {} } },
          "else": { "not": { "type": "object", "required": ["compensatingControl"] } }
        }
      ]
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source", "custodian", "collectedAt"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "custodian": { "type": "string", "minLength": 1 },
        "collectedAt": { "type": "string", "format": "date-time" },
        "integrityRef": { "type": "string", "minLength": 1 }
      }
    },
    "legacyCompensatingControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "rationale", "owner", "evidenceReferences"],
      "properties": {
        "controlId": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "legacyFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "summary", "state"],
      "properties": {
        "severity": { "enum": ["none", "low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "state": { "enum": ["open", "accepted", "resolved", "not-applicable"] }
      }
    },
    "legacyRemediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "action", "owner", "state"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "state": { "enum": ["proposed", "planned", "in-progress", "verified", "accepted"] }
      }
    }
  }
}
