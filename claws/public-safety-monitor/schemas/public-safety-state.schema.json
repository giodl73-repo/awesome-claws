{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["watchScope", "generatedAt", "alerts", "observations", "actions", "safetyOwner", "state"],
  "properties": {
    "watchScope": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "alerts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "issuer", "canonicalUrl", "issuedAt", "expiresAt", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "issuedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["official-active", "official-superseded", "official-expired", "unverified"] }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "summary", "alertRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["official", "forecast-context", "feed-gap", "contradiction"] },
          "summary": { "type": "string", "minLength": 1 },
          "alertRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "alertRefs", "owner", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "alertRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 },
          "state": { "enum": ["proposed", "authorized-by-owner", "completed-by-owner"] }
        }
      }
    },
    "safetyOwner": { "type": "string", "minLength": 1 },
    "state": { "enum": ["monitoring", "needs-official-verification", "ready-for-owner-review", "closed-by-owner"] }
  }
}
