{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentScope", "assessmentMode", "authorizationRef", "assets", "scenarios", "riskOwner", "assessmentState"],
      "properties": {
        "assessmentScope": { "type": "string", "minLength": 1 },
        "assessmentMode": { "enum": ["evidence-review", "safe-reproduction", "active-testing"] },
        "authorizationRef": { "type": "string", "minLength": 1 },
        "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyAsset" } },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyScenario" } },
        "riskOwner": { "type": "string", "minLength": 1 },
        "assessmentState": { "enum": ["not-reviewable", "needs-remediation", "ready-for-risk-owner-review", "closed-by-risk-owner"] }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "assessmentMode": { "const": "active-testing" } },
            "required": ["assessmentMode"]
          },
          "then": { "type": "object", "required": ["stopConditions"], "properties": { "stopConditions": {} } }
        }
      ]
    },
    {
      "type": "object",
      "required": ["schemaVersion", "assessment", "principals", "assets", "scenarios", "observations", "evidence", "controlAssertions", "remediations", "verifications", "limitations", "recommendation", "owner", "ownerId", "handoff"],
      "properties": {
        "schemaVersion": { "const": "awesomeClaws.threatAssessment.v1" },
        "assessment": { "type": "object" },
        "principals": { "type": "array" },
        "assets": { "type": "array" },
        "scenarios": { "type": "array" },
        "observations": { "type": "array" },
        "evidence": { "type": "array" },
        "controlAssertions": { "type": "array" },
        "remediations": { "type": "array" },
        "verifications": { "type": "array" },
        "limitations": { "type": "array" },
        "recommendation": { "type": ["object", "null"] },
        "owner": { "type": "string" },
        "ownerId": { "type": "string" },
        "handoff": { "type": "object" }
      },
      "not": { "required": ["assessmentScope"] }
    }
  ],
  "$defs": {
    "legacyAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "trustBoundary", "criticality"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "trustBoundary": { "type": "string", "minLength": 1 },
        "criticality": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "legacyScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "asset", "threatSource", "attackTechnique", "exploitPreconditions", "existingControls", "evidenceState", "evidence", "likelihood", "impact", "confidence", "severity", "remediation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "threatSource": { "type": "string", "minLength": 1 },
        "attackTechnique": { "type": "string", "minLength": 1 },
        "exploitPreconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "existingControls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceState": { "enum": ["reproduced", "supported", "inferred", "untested", "contradictory"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyEvidence" } },
        "likelihood": { "enum": ["rare", "unlikely", "possible", "likely", "almost-certain"] },
        "impact": { "enum": ["negligible", "minor", "moderate", "major", "severe"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "remediation": { "$ref": "#/$defs/legacyRemediation" }
      }
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source", "observedAt", "state"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "state": { "enum": ["verified", "stale", "missing", "conflicting"] }
      }
    },
    "legacyRemediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "owner", "verification", "state"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "state": { "enum": ["proposed", "planned", "in-progress", "verified", "accepted"] }
      }
    }
  }
}
