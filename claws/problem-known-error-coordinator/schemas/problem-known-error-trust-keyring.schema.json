{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.example/schemas/problem-known-error-trust-keyring.schema.json",
  "title": "Caller-supplied problem and known-error trust keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedIssuerRefs", "keys"],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.problemKnownErrorTrustKeyring.v1"
    },
    "allowedIssuerRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/key"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "principalRef",
        "issuerRef",
        "keyRef",
        "algorithm",
        "publicKeyPem"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["issuer", "principal"]
        },
        "principalRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuerRef": {
          "$ref": "#/$defs/id"
        },
        "keyRef": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        },
        "algorithm": {
          "const": "ed25519"
        },
        "publicKeyPem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
