{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/receipt-workpaper-report.schema.json",
  "title": "Receipt workpaper report with complete input and recomputed conservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "owner", "evidence", "findings", "reviewQuestions", "receiptCoverage", "allocationCoverage", "receipts", "allocations", "invoiceBalancesChanged", "accountingEntriesPosted"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.receiptWorkpaperReport.v1" },
    "state": { "enum": ["blocked", "ready-for-owner-review"] },
    "owner": { "$ref": "#/$defs/id" },
    "evidence": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json" },
    "findings": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["code", "id"],
      "properties": { "code": { "$ref": "#/$defs/code" }, "id": { "$ref": "#/$defs/id" } }
    } },
    "reviewQuestions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "receiptCoverage": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "allocationCoverage": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "receipts": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "identityRef", "sourceRef", "sourceRevision", "sourceRecord", "at", "currency", "amountMinor", "status", "scale", "allocatedMinor", "unallocatedMinor", "allocationRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "identityRef": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/$defs/identity" },
        "sourceRef": { "$ref": "#/$defs/id" }, "sourceRevision": { "$ref": "#/$defs/id" }, "sourceRecord": { "$ref": "#/$defs/id" },
        "at": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/$defs/time" },
        "currency": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/$defs/currency" },
        "amountMinor": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/$defs/amount" },
        "status": { "enum": ["current", "conflicting", "reversed", "superseded"] },
        "scale": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
        "allocatedMinor": { "$ref": "#/$defs/derivedAmount" },
        "unallocatedMinor": { "$ref": "#/$defs/derivedAmount" },
        "allocationRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    } },
    "allocations": { "type": "array", "items": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/properties/allocations/items" } },
    "invoiceBalancesChanged": { "const": false },
    "accountingEntriesPosted": { "const": false }
  },
  "$defs": {
    "id": { "$ref": "https://awesome-claws.local/schemas/receipt-workpaper.schema.json#/$defs/id" },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "derivedAmount": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["owner", "code", "ref", "question"],
      "properties": { "owner": { "$ref": "#/$defs/id" }, "code": { "$ref": "#/$defs/code" }, "ref": { "$ref": "#/$defs/id" }, "question": { "type": "string", "minLength": 1 } }
    }
  }
}
