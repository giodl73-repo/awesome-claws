{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/resume-portfolio.schema.json",
  "title": "Resume portfolio curator artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "portfolio", "sources", "claims", "materials", "roleFits", "redactions", "gaps", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.resumePortfolio.v1" },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "targetRole", "asOf", "timezone"],
      "properties": {
        "id": { "type": "string", "pattern": "^portfolio-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "targetRole": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "freshness", "privacy", "asOf"],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["resume-draft", "portfolio-link", "project-note", "credential-record", "certificate", "performance-artifact", "publication", "public-profile", "reference-note", "owner-note"] },
          "label": { "type": "string", "minLength": 1 },
          "freshness": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] },
          "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] },
          "asOf": { "type": "string", "format": "date" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "claim", "state", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["role", "project", "metric", "credential", "education", "award", "publication", "skill", "employment-date", "public-profile"] },
          "claim": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["supported", "needs-owner-review", "unsupported", "stale", "conflicting", "sensitive"] },
          "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "state", "claimRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^material-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["resume", "portfolio", "profile-summary", "project-case-study", "work-sample", "credential-list", "reference-list"] },
          "label": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["draft-for-owner-review", "ready-for-owner-review", "blocked", "stale", "missing-evidence"] },
          "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" } },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "roleFits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "roleNeed", "fit", "state", "claimRefs", "materialRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^fit-[a-z0-9-]+$" },
          "roleNeed": { "type": "string", "minLength": 1 },
          "fit": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["supported", "needs-owner-review", "gap", "blocked"] },
          "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" } },
          "materialRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^material-[a-z0-9-]+$" } }
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "state", "refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^redaction-[a-z0-9-]+$" },
          "reason": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["recommended", "needs-owner-review", "approved-by-owner", "blocked"] },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|claim|material)-[a-z0-9-]+$" } }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reason", "refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^gap-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["missing-evidence", "stale-link", "unsupported-claim", "conflict", "sensitive-detail", "role-mismatch", "credential-risk", "publication-risk"] },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|claim|material|fit|redaction)-[a-z0-9-]+$" } }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "refs", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|claim|material|fit|redaction|gap)-[a-z0-9-]+$" } },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["submit-application", "upload-file", "publish-profile", "update-portfolio", "message-recruiter", "contact-employer", "change-account", "fabricate-credential", "invent-metric", "alter-employment-date", "claim-degree", "claim-award", "claim-publication", "legal-advice", "immigration-advice", "tax-advice", "compensation-advice", "career-advice", "employment-advice"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"],
      "properties": {
        "state": { "type": "string", "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": { "type": "array", "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" } },
        "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
