        "normalizedUnits": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "periodStartsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "periodEndsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "rowDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mappingState": {
                "const": "mapped"
              }
            },
            "required": [
              "mappingState"
            ]
          },
          "then": {
            "properties": {
              "mappingRef": {
                "$ref": "#/$defs/id"
              },
              "rightRef": {
                "$ref": "#/$defs/id"
              },
              "poolRef": {
                "$ref": "#/$defs/id"
              },
              "normalizedUnits": {
                "$ref": "#/$defs/quantity"
