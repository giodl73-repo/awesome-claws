      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "predecessorRoundRef": {
          "$ref": "#/$defs/id"
        },
        "predecessorRoundDigest": {
          "$ref": "#/$defs/digest"
        },
        "organizationRef": {
          "$ref": "#/$defs/id"
        },
        "agreementRef": {
          "$ref": "#/$defs/id"
        },
        "licenseProgramRef": {
          "$ref": "#/$defs/id"
        },
        "periodStartsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "periodEndsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "cutoffAt": {
          "$ref": "#/$defs/timestamp"
        },
        "opensAt": {
          "$ref": "#/$defs/timestamp"
        },
        "closesAt": {
          "$ref": "#/$defs/timestamp"
        },
        "rightsManifestRef": {
          "$ref": "#/$defs/id"
        },
        "rightsManifestVersion": {
          "$ref": "#/$defs/version"
        },
        "rightsManifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "skuMappingRegisterRef": {
          "$ref": "#/$defs/id"
        },
        "skuMappingVersion": {
          "$ref": "#/$defs/version"
        },
        "skuMappingDigest": {
          "$ref": "#/$defs/digest"
        },
        "authorityRosterRef": {
          "$ref": "#/$defs/id"
        },
        "authorityRosterVersion": {
          "$ref": "#/$defs/version"
        },
        "authorityRosterDigest": {
          "$ref": "#/$defs/digest"
        },
        "destination": {
          "$ref": "#/$defs/controlledRef"
        },
        "rightRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "poolRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "skuMappingRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "sourceExportRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "assignmentRefs": {
          "$ref": "#/$defs/idList"
        },
        "consumptionRefs": {
          "$ref": "#/$defs/idList"
        },
        "positionRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "exceptionRefs": {
          "$ref": "#/$defs/idList"
        },
        "decisionRefs": {
          "$ref": "#/$defs/idList"
        },
        "blockerRefs": {
          "$ref": "#/$defs/idList"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "roundDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "rightsManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "organizationRef",
        "agreementRef",
        "licenseProgramRef",
        "effectiveFrom",
        "effectiveUntil",
        "confirmedAt",
        "confirmedByRef",
        "rightRefs",
        "poolRefs",
        "contentDigest",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "organizationRef": {
          "$ref": "#/$defs/id"
        },
        "agreementRef": {
          "$ref": "#/$defs/id"
        },
        "licenseProgramRef": {
          "$ref": "#/$defs/id"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/timestamp"
        },
        "effectiveUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "confirmedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "confirmedByRef": {
          "$ref": "#/$defs/id"
        },
        "rightRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "poolRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "skuMappingRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "organizationRef",
        "agreementRef",
        "licenseProgramRef",
        "confirmedAt",
        "confirmedByRef",
        "mappingRefs",
        "contentDigest",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "organizationRef": {
          "$ref": "#/$defs/id"
        },
        "agreementRef": {
          "$ref": "#/$defs/id"
        },
        "licenseProgramRef": {
          "$ref": "#/$defs/id"
        },
        "confirmedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "confirmedByRef": {
          "$ref": "#/$defs/id"
        },
        "mappingRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestRef",
        "metric",
        "normalizedUnit",
        "purchasedUnits",
        "effectiveFrom",
        "effectiveUntil",
        "poolRefs",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "manifestRef": {
          "$ref": "#/$defs/id"
        },
        "metric": {
          "enum": [
            "assigned-user",
            "active-user",
            "device",
            "processor-core",
            "consumed-unit"
          ]
        },
        "normalizedUnit": {
          "const": "license-unit"
        },
        "purchasedUnits": {
          "$ref": "#/$defs/quantity"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/timestamp"
        },
        "effectiveUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "poolRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rightRef",
        "entitledUnits",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rightRef": {
          "$ref": "#/$defs/id"
        },
        "entitledUnits": {
          "$ref": "#/$defs/quantity"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "skuMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mappingRegisterRef",
        "sourceSku",
        "rightRef",
        "poolRefs",
        "metric",
        "sourceUnit",
        "normalizedUnit",
        "conversionNumerator",
        "conversionDenominator",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mappingRegisterRef": {
          "$ref": "#/$defs/id"
        },
        "sourceSku": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
        },
        "rightRef": {
          "$ref": "#/$defs/id"
        },
        "poolRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "metric": {
          "enum": [
            "assigned-user",
            "active-user",
            "device",
            "processor-core",
            "consumed-unit"
          ]
        },
        "sourceUnit": {
          "enum": [
            "seat",
            "user",
            "device",
            "core",
            "unit"
          ]
        },
        "normalizedUnit": {
          "const": "license-unit"
        },
        "conversionNumerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "conversionDenominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "sourceExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "version",
        "organizationRef",
        "agreementRef",
        "licenseProgramRef",
        "periodStartsAt",
        "periodEndsAt",
        "cutoffAt",
        "suppliedAt",
        "suppliedByRef",
        "rowRefs",
        "contentDigest",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "assignment-export",
            "consumption-export"
