      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "destinationApproval": {
      "$ref": "#/$defs/destinationApproval"
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
