              "rightRef": {
                "type": "null"
              },
              "poolRef": {
                "type": "null"
              },
              "normalizedUnits": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingState": {
                "const": "conflict"
              }
            },
            "required": [
              "mappingState"
            ]
          },
          "then": {
            "properties": {
              "mappingRef": {
                "$ref": "#/$defs/id"
              },
              "rightRef": {
                "$ref": "#/$defs/id"
              },
              "poolRef": {
                "$ref": "#/$defs/id"
              },
              "normalizedUnits": {
