        "version": {
          "$ref": "#/$defs/version"
        },
        "organizationRef": {
          "$ref": "#/$defs/id"
        },
        "agreementRef": {
          "$ref": "#/$defs/id"
        },
        "licenseProgramRef": {
          "$ref": "#/$defs/id"
        },
        "periodStartsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "periodEndsAt": {
          "$ref": "#/$defs/timestamp"
        },
        "cutoffAt": {
          "$ref": "#/$defs/timestamp"
        },
        "suppliedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "suppliedByRef": {
          "$ref": "#/$defs/id"
        },
        "rowRefs": {
          "$ref": "#/$defs/idList"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exportRef",
        "sourceSku",
        "mappingState",
        "periodState",
        "mappingRef",
        "rightRef",
        "poolRef",
        "sourceUnits",
        "normalizedUnits",
        "observedAt",
        "rowDigest",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "exportRef": {
          "$ref": "#/$defs/id"
        },
        "sourceSku": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
        },
        "mappingState": {
          "enum": [
            "mapped",
            "unmapped",
            "conflict"
          ]
        },
        "periodState": {
          "enum": [
            "in-period",
            "out-of-period"
          ]
        },
        "mappingRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "poolRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUnits": {
          "$ref": "#/$defs/quantity"
        },
        "normalizedUnits": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "rowDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mappingState": {
                "const": "mapped"
              }
            },
            "required": [
              "mappingState"
            ]
          },
          "then": {
            "properties": {
              "mappingRef": {
                "$ref": "#/$defs/id"
              },
              "rightRef": {
                "$ref": "#/$defs/id"
              },
              "poolRef": {
                "$ref": "#/$defs/id"
              },
              "normalizedUnits": {
                "$ref": "#/$defs/quantity"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingState": {
                "const": "unmapped"
              }
            },
            "required": [
              "mappingState"
            ]
          },
          "then": {
            "properties": {
              "mappingRef": {
                "type": "null"
              },
              "rightRef": {
                "type": "null"
              },
              "poolRef": {
                "type": "null"
              },
              "normalizedUnits": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingState": {
                "const": "conflict"
              }
            },
            "required": [
              "mappingState"
            ]
          },
          "then": {
            "properties": {
              "mappingRef": {
                "$ref": "#/$defs/id"
              },
              "rightRef": {
                "$ref": "#/$defs/id"
              },
              "poolRef": {
                "$ref": "#/$defs/id"
              },
              "normalizedUnits": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exportRef",
        "sourceSku",
        "mappingState",
        "periodState",
        "mappingRef",
        "rightRef",
        "poolRef",
        "sourceUnits",
        "normalizedUnits",
        "periodStartsAt",
        "periodEndsAt",
        "observedAt",
        "rowDigest",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "exportRef": {
          "$ref": "#/$defs/id"
        },
        "sourceSku": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
        },
        "mappingState": {
          "enum": [
            "mapped",
            "unmapped",
            "conflict"
          ]
        },
        "periodState": {
          "enum": [
            "in-period",
            "out-of-period"
          ]
        },
        "mappingRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "poolRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUnits": {
