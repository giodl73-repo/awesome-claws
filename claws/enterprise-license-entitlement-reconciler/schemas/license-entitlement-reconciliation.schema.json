{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/schemas/license-entitlement-reconciliation.schema.json",
  "title": "Enterprise license entitlement reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "round",
    "rightsManifest",
    "skuMappingRegister",
    "rights",
    "pools",
    "skuMappings",
    "sourceExports",
    "assignments",
    "consumption",
    "principals",
    "authorityRoster",
    "authorityGrants",
    "positions",
    "exceptions",
    "decisions",
    "blockers",
    "evidence",
    "coverage",
    "destinationApproval",
    "handoff"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.enterpriseLicenseEntitlementReconciliation.v1"
    },
    "artifactId": {
      "$ref": "#/$defs/id"
    },
    "round": {
      "$ref": "#/$defs/round"
    },
    "rightsManifest": {
      "$ref": "#/$defs/rightsManifest"
    },
    "skuMappingRegister": {
      "$ref": "#/$defs/skuMappingRegister"
    },
    "rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/right"
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pool"
      }
    },
    "skuMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skuMapping"
      }
    },
    "sourceExports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/sourceExport"
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "consumption": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consumption"
      }
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/principal"
      }
    },
    "authorityRoster": {
      "$ref": "#/$defs/authorityRoster"
