  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "delta": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "controlledRef": {
      "type": "string",
      "pattern": "^controlled://[a-z0-9][a-z0-9-]{2,60}/[a-z0-9][a-z0-9._/-]*$"
    },
    "contentAddressedRef": {
      "type": "string",
      "pattern": "^controlled://[a-z0-9][a-z0-9-]{2,60}/[a-z0-9][a-z0-9._/-]*@sha256-[0-9a-f]{64}$"
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "predecessorRoundRef",
        "predecessorRoundDigest",
        "organizationRef",
        "agreementRef",
        "licenseProgramRef",
        "periodStartsAt",
        "periodEndsAt",
        "cutoffAt",
        "opensAt",
        "closesAt",
        "rightsManifestRef",
        "rightsManifestVersion",
        "rightsManifestDigest",
        "skuMappingRegisterRef",
        "skuMappingVersion",
        "skuMappingDigest",
        "authorityRosterRef",
        "authorityRosterVersion",
        "authorityRosterDigest",
        "destination",
        "rightRefs",
        "poolRefs",
        "skuMappingRefs",
        "sourceExportRefs",
        "assignmentRefs",
        "consumptionRefs",
        "positionRefs",
        "exceptionRefs",
        "decisionRefs",
        "blockerRefs",
        "evidenceRefs",
        "roundDigest"
