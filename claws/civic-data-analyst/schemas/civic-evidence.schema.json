{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "geography", "period", "sources", "measures", "comparisons", "limitations", "publicationOwner", "publicationState"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["tract-set", "neighborhood-set", "district-set", "jurisdiction"] }
      }
    },
    "period": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "dataset", "vintage", "retrievedAt", "url", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "dataset": { "type": "string", "minLength": 1 },
          "vintage": { "type": "string", "minLength": 1 },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "state": { "enum": ["official-current", "official-revised", "modeled", "stale", "missing"] }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "value", "unit", "denominator", "sourceRefs", "geographyRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "denominator": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "geographyRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "measureRefs", "method"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "measureRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "method": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "publicationOwner": { "type": "string", "minLength": 1 },
    "publicationState": { "enum": ["private-draft", "ready-for-owner-review", "approved-by-owner", "withheld-by-owner"] }
  }
}
