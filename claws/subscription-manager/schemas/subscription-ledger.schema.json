{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "portfolio", "sources", "subscriptions", "renewals", "usage", "overlaps", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.subscriptionLedger.v1" },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "currency", "timezone", "asOf", "reviewWindowDays"],
      "properties": {
        "id": { "type": "string", "pattern": "^subscription-portfolio-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "reviewWindowDays": { "type": "integer", "minimum": 1, "maximum": 366 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["receipt", "invoice", "vendor-email", "app-store-export", "calendar-note", "usage-note", "owner-note", "bank-feed"] },
          "authority": { "enum": ["user-supplied", "vendor-supplied", "app-store-export", "calendar-export", "banking-system"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] }
        }
      }
    },
    "subscriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "service", "category", "owner", "state", "cadence", "amount", "currency", "amountState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^sub-[a-z0-9-]+$" },
          "service": { "type": "string", "minLength": 1 },
          "category": { "enum": ["streaming", "software", "cloud", "news", "fitness", "storage", "membership", "telecom", "other"] },
          "owner": { "type": "string", "minLength": 1 },
          "state": { "enum": ["active", "paused", "trial", "unknown", "cancelled-by-owner"] },
          "cadence": { "enum": ["monthly", "annual", "quarterly", "weekly", "unknown"] },
          "amount": { "type": ["number", "null"], "minimum": 0 },
          "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "amountState": { "enum": ["supplied", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "renewals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subscriptionRef", "renewsAt", "windowState", "priceChange", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^renewal-[a-z0-9-]+$" },
          "subscriptionRef": { "type": "string", "minLength": 1 },
          "renewsAt": { "type": ["string", "null"], "format": "date-time" },
          "windowState": { "enum": ["inside-review-window", "outside-review-window", "missing", "conflicting"] },
          "priceChange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "previousAmount", "newAmount", "currency"],
            "properties": {
              "state": { "enum": ["none", "increase", "decrease", "unknown", "conflicting"] },
              "previousAmount": { "type": ["number", "null"], "minimum": 0 },
              "newAmount": { "type": ["number", "null"], "minimum": 0 },
              "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
            }
          },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subscriptionRef", "state", "summary", "observedAt", "sourceRefs"],
        "properties": {
          "subscriptionRef": { "type": "string", "minLength": 1 },
          "state": { "enum": ["used-recently", "unused-reported", "unknown", "stale", "conflicting"] },
          "summary": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "overlaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subscriptionRefs", "kind", "summary", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^overlap-[a-z0-9-]+$" },
          "subscriptionRefs": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "kind": { "enum": ["duplicate-category", "feature-overlap", "household-overlap", "unknown"] },
          "summary": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subscriptionRefs", "question", "reason", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "subscriptionRefs": { "$ref": "#/$defs/refs" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "enum": ["connect-bank", "connect-credit-card", "cancel-subscription", "subscribe", "downgrade", "upgrade", "negotiate", "contact-vendor", "change-payment", "modify-account", "modify-calendar", "send-message", "financial-advice"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "enum": ["connect-bank", "connect-credit-card", "cancel-subscription", "subscribe", "downgrade", "upgrade", "negotiate", "contact-vendor", "change-payment", "modify-account", "modify-calendar", "send-message", "financial-advice"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
