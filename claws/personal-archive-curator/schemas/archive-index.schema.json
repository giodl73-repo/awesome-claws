{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "archive", "sources", "items", "collections", "duplicates", "retrievalCues", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.archiveIndex.v1" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^archive-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["file-export", "folder-list", "note-index", "link-list", "receipt-list", "warranty-record", "photo-description", "owner-memory-note"] },
          "authority": { "enum": ["user-supplied", "device-export", "cloud-export", "merchant", "manufacturer", "owner-note"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] },
          "privacy": { "enum": ["normal", "private", "sensitive", "location-sensitive", "account-sensitive", "face-sensitive", "valuable-sensitive"] }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "sourceRefs", "dateState", "privacy", "retentionState", "suggestedTags", "pathDisclosure"],
        "properties": {
          "id": { "type": "string", "pattern": "^item-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["document", "note", "link", "receipt", "warranty", "photo", "memory", "other"] },
          "sourceRefs": { "$ref": "#/$defs/refs" },
          "dateState": { "enum": ["known", "approximate", "missing", "conflicting"] },
          "privacy": { "enum": ["normal", "private", "sensitive", "location-sensitive", "account-sensitive", "face-sensitive", "valuable-sensitive"] },
          "retentionState": { "enum": ["keep", "review", "unknown", "possible-duplicate", "do-not-delete"] },
          "suggestedTags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "pathDisclosure": { "enum": ["safe-label-only", "owner-visible-path", "blocked-private-path"] }
        }
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "itemRefs", "proposedFolder", "privacy", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^collection-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "itemRefs": { "$ref": "#/$defs/refs" },
          "proposedFolder": { "type": "string", "minLength": 1 },
          "privacy": { "enum": ["normal", "private", "sensitive", "mixed"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemRefs", "confidence", "reason", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^duplicate-[a-z0-9-]+$" },
          "itemRefs": { "$ref": "#/$defs/twoOrMoreRefs" },
          "confidence": { "enum": ["strong", "possible", "weak"] },
          "reason": { "type": "string", "minLength": 1 },
          "action": { "enum": ["owner-review", "keep-both", "blocked-delete"] }
        }
      }
    },
    "retrievalCues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "need", "itemRefs", "sourceRefs", "cue", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^cue-[a-z0-9-]+$" },
          "need": { "enum": ["receipt", "warranty", "photo", "note", "link", "memory", "tax", "move", "other"] },
          "itemRefs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" },
          "cue": { "type": "string", "minLength": 1 },
          "state": { "enum": ["ready", "review-needed", "blocked-private"] }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "itemRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "itemRefs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["delete-file", "move-file", "rename-file", "upload-file", "share-file", "publish-file", "change-permissions", "train-memory", "run-face-recognition", "infer-sensitive-fact", "expose-private-path"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "enum": ["delete-file", "move-file", "rename-file", "upload-file", "share-file", "publish-file", "change-permissions", "train-memory", "run-face-recognition", "infer-sensitive-fact", "expose-private-path"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "twoOrMoreRefs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
