{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/schemas/estate-administration.schema.json",
  "title": "Estate administration ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estate",
    "authorities",
    "sources",
    "assets",
    "liabilities",
    "notices",
    "claims",
    "deadlines",
    "actions",
    "distributions",
    "questions",
    "gaps",
    "review",
    "prohibitedActions"
  ],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.estateAdministration.v1" },
    "estate": { "$ref": "#/$defs/estate" },
    "authorities": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/authority" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
    "liabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/liability" } },
    "notices": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "deadlines": { "type": "array", "items": { "$ref": "#/$defs/deadline" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "distributions": { "type": "array", "items": { "$ref": "#/$defs/distribution" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "review": { "$ref": "#/$defs/review" },
    "prohibitedActions": { "$ref": "#/$defs/prohibitedActions" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 240 },
    "controlledRef": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?:workspace|vault|record)://[^\\s]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "refArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyRefArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "nullableTimestamp": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "nullableAmount": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
    "nullableCurrency": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] },
    "estate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stableEstateRef", "generalizedJurisdiction", "status", "personalRepresentativeAuthorityRef", "approvedDestinationRef", "asOf", "revision", "previousRevisionRef", "sourceRefs", "assetRefs", "liabilityRefs", "noticeRefs", "claimRefs", "deadlineRefs", "actionRefs", "distributionRefs", "questionRefs", "gapRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stableEstateRef": { "$ref": "#/$defs/shortText" },
        "generalizedJurisdiction": { "$ref": "#/$defs/shortText" },
        "status": { "const": "open-administration" },
        "personalRepresentativeAuthorityRef": { "$ref": "#/$defs/id" },
        "approvedDestinationRef": { "$ref": "#/$defs/controlledRef" },
        "asOf": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 1 },
        "previousRevisionRef": { "$ref": "#/$defs/nullableId" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "assetRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "liabilityRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "noticeRefs": { "$ref": "#/$defs/refArray" },
        "claimRefs": { "$ref": "#/$defs/refArray" },
        "deadlineRefs": { "$ref": "#/$defs/refArray" },
        "actionRefs": { "$ref": "#/$defs/refArray" },
        "distributionRefs": { "$ref": "#/$defs/refArray" },
        "questionRefs": { "$ref": "#/$defs/refArray" },
        "gapRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "scope", "authorizationSourceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["personal-representative", "court", "legal-counsel", "tax-professional", "valuation-professional", "financial-institution", "creditor-or-claimant", "beneficiary-or-interested-party", "property-custodian"] },
        "label": { "$ref": "#/$defs/shortText" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["estate-administration-owner", "source-issuer", "legal-question", "tax-question", "valuation-question", "institutional-record", "claim-position", "beneficiary-question", "receipt-issuer", "review"] }
        },
        "authorizationSourceRef": { "$ref": "#/$defs/nullableId" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subjectRef", "issuerAuthorityRef", "controlledRef", "revision", "assertedAt", "retrievedAt", "freshness", "minimized", "containsSecrets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["death-record", "will-or-trust-pointer", "appointment-instrument", "court-order", "professional-instruction", "owner-inventory", "asset-record", "liability-record", "valuation-record", "statement", "notice-record", "claim-record", "claim-decision", "owner-action-note", "independent-receipt", "distribution-proposal", "distribution-approval", "professional-answer", "gap-resolution"] },
        "subjectRef": { "$ref": "#/$defs/id" },
        "issuerAuthorityRef": { "$ref": "#/$defs/id" },
        "controlledRef": { "$ref": "#/$defs/controlledRef" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
        "assertedAt": { "$ref": "#/$defs/timestamp" },
        "retrievedAt": { "$ref": "#/$defs/timestamp" },
        "freshness": { "enum": ["current", "superseded", "stale", "unknown"] },
        "minimized": { "const": true },
        "containsSecrets": { "const": false }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "label", "kind", "institutionOrCustodianAuthorityRef", "ownershipEvidenceState", "ownershipSourceRefs", "valueState", "valueMinorUnits", "currency", "valuationSourceRefs", "actionRefs", "distributionRefs", "gapRefs", "ownershipDeterminationByClaw", "valuationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/shortText" },
        "kind": { "enum": ["bank-account", "real-property", "vehicle", "personal-property", "insurance-or-benefit", "business-interest", "receivable", "digital-asset", "other"] },
        "institutionOrCustodianAuthorityRef": { "$ref": "#/$defs/nullableId" },
        "ownershipEvidenceState": { "enum": ["supported", "unknown", "conflicting", "professional-review-needed"] },
        "ownershipSourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "valueState": { "enum": ["current", "estimated", "stale", "unknown", "conflicting"] },
        "valueMinorUnits": { "$ref": "#/$defs/nullableAmount" },
        "currency": { "$ref": "#/$defs/nullableCurrency" },
        "valuationSourceRefs": { "$ref": "#/$defs/refArray" },
        "actionRefs": { "$ref": "#/$defs/refArray" },
        "distributionRefs": { "$ref": "#/$defs/refArray" },
        "gapRefs": { "$ref": "#/$defs/refArray" },
        "ownershipDeterminationByClaw": { "const": false },
        "valuationByClaw": { "const": false }
      }
    },
    "liability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "label", "kind", "claimRef", "amountState", "amountMinorUnits", "currency", "sourceRefs", "actionRefs", "gapRefs", "validityDeterminationByClaw", "priorityDeterminationByClaw", "payableDeterminationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/shortText" },
        "kind": { "enum": ["creditor-claim", "tax", "administration-expense", "loan", "secured-debt", "utility", "other"] },
        "claimRef": { "$ref": "#/$defs/nullableId" },
        "amountState": { "enum": ["documented", "disputed", "unknown", "conflicting", "professional-review-needed"] },
        "amountMinorUnits": { "$ref": "#/$defs/nullableAmount" },
        "currency": { "$ref": "#/$defs/nullableCurrency" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "actionRefs": { "$ref": "#/$defs/refArray" },
        "gapRefs": { "$ref": "#/$defs/refArray" },
        "validityDeterminationByClaw": { "const": false },
        "priorityDeterminationByClaw": { "const": false },
        "payableDeterminationByClaw": { "const": false }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "kind", "subjectRefs", "ownerAuthorityRef", "state", "noticeAt", "sourceRefs", "receiptSourceRef", "applicabilityDeterminationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["court-notice", "creditor-notice", "beneficiary-notice", "tax-notice", "institution-notice", "public-notice", "other"] },
        "subjectRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "ownerAuthorityRef": { "$ref": "#/$defs/id" },
        "state": { "enum": ["planned", "attempted", "owner-completed-receipted", "disputed", "unknown", "withdrawn"] },
        "noticeAt": { "$ref": "#/$defs/nullableTimestamp" },
        "sourceRefs": { "$ref": "#/$defs/refArray" },
        "receiptSourceRef": { "$ref": "#/$defs/nullableId" },
        "applicabilityDeterminationByClaw": { "const": false }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "claimantAuthorityRef", "liabilityRef", "kind", "state", "assertedAmountMinorUnits", "currency", "sourceRefs", "decisionSourceRef", "actionRefs", "gapRefs", "validityDeterminationByClaw", "priorityDeterminationByClaw", "entitlementDeterminationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "claimantAuthorityRef": { "$ref": "#/$defs/id" },
        "liabilityRef": { "$ref": "#/$defs/nullableId" },
        "kind": { "enum": ["creditor", "tax", "reimbursement", "beneficiary", "ownership", "other"] },
        "state": { "enum": ["received", "disputed", "withdrawn", "allowed-by-authority", "rejected-by-authority", "unknown"] },
        "assertedAmountMinorUnits": { "$ref": "#/$defs/nullableAmount" },
        "currency": { "$ref": "#/$defs/nullableCurrency" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "decisionSourceRef": { "$ref": "#/$defs/nullableId" },
        "actionRefs": { "$ref": "#/$defs/refArray" },
        "gapRefs": { "$ref": "#/$defs/refArray" },
        "validityDeterminationByClaw": { "const": false },
        "priorityDeterminationByClaw": { "const": false },
        "entitlementDeterminationByClaw": { "const": false }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "kind", "subjectRefs", "candidateAt", "timezone", "state", "sourceRefs", "confirmedByAuthorityRef", "confirmationSourceRef", "applicabilityDeterminationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["court-filing", "notice", "creditor-claim", "tax", "asset", "professional-review", "other"] },
        "subjectRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "candidateAt": { "$ref": "#/$defs/nullableTimestamp" },
        "timezone": { "$ref": "#/$defs/shortText" },
        "state": { "enum": ["owner-supplied", "professional-supplied", "official-supplied", "confirmed", "conflicting", "unknown"] },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "confirmedByAuthorityRef": { "$ref": "#/$defs/nullableId" },
        "confirmationSourceRef": { "$ref": "#/$defs/nullableId" },
        "applicabilityDeterminationByClaw": { "const": false }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "subjectRefs", "kind", "ownerAuthorityRef", "state", "attemptedAt", "sourceRefs", "receiptSourceRef", "externalExecution", "agentExecuted"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "subjectRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "kind": { "enum": ["contact", "file", "publish-notice", "access-account", "transfer-title", "sell", "pay", "settle", "distribute", "sign", "schedule", "review-record", "other"] },
        "ownerAuthorityRef": { "$ref": "#/$defs/id" },
        "state": { "enum": ["proposed", "attempted", "failed", "blocked", "withdrawn", "owner-completed-receipted"] },
        "attemptedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "sourceRefs": { "$ref": "#/$defs/refArray" },
        "receiptSourceRef": { "$ref": "#/$defs/nullableId" },
        "externalExecution": { "const": "owner-only" },
        "agentExecuted": { "const": false }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "beneficiaryAuthorityRef", "assetRefs", "kind", "state", "amountMinorUnits", "currency", "proposalSourceRef", "approvalSourceRef", "actionRef", "receiptSourceRef", "entitlementDeterminationByClaw", "authorizationDeterminationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "beneficiaryAuthorityRef": { "$ref": "#/$defs/id" },
        "assetRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "kind": { "enum": ["cash", "property", "in-kind", "other"] },
        "state": { "enum": ["proposed", "approved-by-authority", "owner-executed-receipted", "withdrawn", "blocked"] },
        "amountMinorUnits": { "$ref": "#/$defs/nullableAmount" },
        "currency": { "$ref": "#/$defs/nullableCurrency" },
        "proposalSourceRef": { "$ref": "#/$defs/id" },
        "approvalSourceRef": { "$ref": "#/$defs/nullableId" },
        "actionRef": { "$ref": "#/$defs/nullableId" },
        "receiptSourceRef": { "$ref": "#/$defs/nullableId" },
        "entitlementDeterminationByClaw": { "const": false },
        "authorizationDeterminationByClaw": { "const": false }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "kind", "subjectRefs", "askedOfAuthorityRef", "state", "sourceRefs", "answerSourceRef", "interpretationByClaw"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["legal", "tax", "valuation", "ownership", "claim", "deadline", "beneficiary", "institution", "closure"] },
        "subjectRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "askedOfAuthorityRef": { "$ref": "#/$defs/id" },
        "state": { "enum": ["open", "answered"] },
        "sourceRefs": { "$ref": "#/$defs/refArray" },
        "answerSourceRef": { "$ref": "#/$defs/nullableId" },
        "interpretationByClaw": { "const": false }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "estateRef", "kind", "subjectRefs", "sourceRefs", "nextOwnerAuthorityRef", "state", "resolutionSourceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "estateRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["missing-authority", "missing-source", "ownership", "value", "liability", "claim", "deadline", "receipt", "distribution", "privacy", "professional-question", "residual-estate-state"] },
        "subjectRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "sourceRefs": { "$ref": "#/$defs/refArray" },
        "nextOwnerAuthorityRef": { "$ref": "#/$defs/id" },
        "state": { "enum": ["open", "resolved"] },
        "resolutionSourceRef": { "$ref": "#/$defs/nullableId" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "state", "nextOwnerAuthorityRef", "openQuestionRefs", "openGapRefs", "disputedClaimRefs", "unknownOwnershipAssetRefs", "valueGapAssetRefs", "unresolvedLiabilityRefs", "missingReceiptActionRefs", "proposedDistributionRefs", "deadlineRefs", "estateClosureClaim", "solvencyConclusion", "reserveSufficiencyConclusion", "entitlementConclusion", "priorityConclusion", "taxConclusion", "legalConclusion", "ownershipConclusion", "valuationConclusion"],
      "properties": {
        "asOf": { "$ref": "#/$defs/timestamp" },
        "state": { "enum": ["blocked", "ready-for-personal-representative-review"] },
        "nextOwnerAuthorityRef": { "$ref": "#/$defs/id" },
        "openQuestionRefs": { "$ref": "#/$defs/refArray" },
        "openGapRefs": { "$ref": "#/$defs/refArray" },
        "disputedClaimRefs": { "$ref": "#/$defs/refArray" },
        "unknownOwnershipAssetRefs": { "$ref": "#/$defs/refArray" },
        "valueGapAssetRefs": { "$ref": "#/$defs/refArray" },
        "unresolvedLiabilityRefs": { "$ref": "#/$defs/refArray" },
        "missingReceiptActionRefs": { "$ref": "#/$defs/refArray" },
        "proposedDistributionRefs": { "$ref": "#/$defs/refArray" },
        "deadlineRefs": { "$ref": "#/$defs/refArray" },
        "estateClosureClaim": { "const": false },
        "solvencyConclusion": { "const": false },
        "reserveSufficiencyConclusion": { "const": false },
        "entitlementConclusion": { "const": false },
        "priorityConclusion": { "const": false },
        "taxConclusion": { "const": false },
        "legalConclusion": { "const": false },
        "ownershipConclusion": { "const": false },
        "valuationConclusion": { "const": false }
      }
    },
    "prohibitedActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalAdvice", "taxAdvice", "valuationAdvice", "investmentAdvice", "ownershipDetermination", "claimDetermination", "priorityDetermination", "entitlementDetermination", "solvencyDetermination", "contact", "filing", "noticePublication", "signature", "certification", "accountAccess", "titleTransfer", "sale", "insuranceChange", "investment", "liquidation", "payment", "settlement", "distribution", "disposal", "destruction", "scheduling", "disclosure", "closure"],
      "properties": {
        "legalAdvice": { "const": false },
        "taxAdvice": { "const": false },
        "valuationAdvice": { "const": false },
        "investmentAdvice": { "const": false },
        "ownershipDetermination": { "const": false },
        "claimDetermination": { "const": false },
        "priorityDetermination": { "const": false },
        "entitlementDetermination": { "const": false },
        "solvencyDetermination": { "const": false },
        "contact": { "const": false },
        "filing": { "const": false },
        "noticePublication": { "const": false },
        "signature": { "const": false },
        "certification": { "const": false },
        "accountAccess": { "const": false },
        "titleTransfer": { "const": false },
        "sale": { "const": false },
        "insuranceChange": { "const": false },
        "investment": { "const": false },
        "liquidation": { "const": false },
        "payment": { "const": false },
        "settlement": { "const": false },
        "distribution": { "const": false },
        "disposal": { "const": false },
        "destruction": { "const": false },
        "scheduling": { "const": false },
        "disclosure": { "const": false },
        "closure": { "const": false }
      }
    }
  }
}
