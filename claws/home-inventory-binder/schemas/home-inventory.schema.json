{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/home-inventory-binder/home-inventory.schema.json",
  "title": "Home Inventory Binder Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plan", "sources", "rooms", "items", "evidence", "warranties", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.homeInventory.v1" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf", "purpose", "privacyMode"],
      "properties": {
        "id": { "type": "string", "pattern": "^inventory-plan-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "purpose": { "type": "string", "minLength": 1 },
        "privacyMode": { "enum": ["owner-only", "household-safe", "redacted"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["owner-note", "receipt", "photo", "warranty", "manual", "serial-label", "app-export", "maintenance-note", "purchase-record", "valuation-note"] },
          "authority": { "enum": ["user-supplied", "merchant", "manufacturer", "app", "service-provider", "valuation-source"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "stale", "missing", "conflicting"] },
          "privacy": { "enum": ["normal", "address-sensitive", "valuable-sensitive", "serial-sensitive", "photo-sensitive", "family-sensitive"] }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^room-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "privacy": { "enum": ["normal", "address-sensitive", "valuable-sensitive", "family-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "roomRef", "condition", "valueState", "privacy", "sourceRefs", "state", "blockedReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^item-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["appliance", "electronics", "furniture", "jewelry", "tools", "documents", "collectible", "other"] },
          "roomRef": { "type": "string", "minLength": 1 },
          "condition": { "enum": ["documented", "possible", "unknown", "conflicting"] },
          "valueState": { "enum": ["supported", "possible", "unknown", "unsupported"] },
          "privacy": { "enum": ["normal", "address-sensitive", "valuable-sensitive", "serial-sensitive", "photo-sensitive", "family-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" },
          "state": { "enum": ["inventory-ready", "review-needed", "blocked"] },
          "blockedReason": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemRef", "kind", "state", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^evidence-[a-z0-9-]+$" },
          "itemRef": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["receipt", "photo", "serial", "manual", "purchase-record", "value-note", "condition-note"] },
          "state": { "enum": ["supported", "possible", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "warranties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemRef", "state", "expiresAt", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^warranty-[a-z0-9-]+$" },
          "itemRef": { "type": "string", "minLength": 1 },
          "state": { "enum": ["active", "possible", "expired", "unknown", "missing"] },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "itemRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "itemRefs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["file-claim", "give-insurance-advice", "give-legal-advice", "upload-inventory", "share-publicly", "contact-insurer", "contact-seller", "sell-item", "donate-item", "discard-item", "move-item", "edit-cloud-album", "disclose-address", "disclose-valuables"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["draft", "ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["file-claim", "give-insurance-advice", "give-legal-advice", "upload-inventory", "share-publicly", "contact-insurer", "contact-seller", "sell-item", "donate-item", "discard-item", "move-item", "edit-cloud-album", "disclose-address", "disclose-valuables"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
