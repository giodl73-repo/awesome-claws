        "nextOwnerRef": {
          "$ref": "#/$defs/id"
        },
        "checkpointRef": {
          "$ref": "#/$defs/id"
        },
        "checkpointDigest": {
          "$ref": "#/$defs/digest"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "codeChangeClaim": {
          "const": "not-claimed"
        },
        "branchChangeClaim": {
          "const": "not-claimed"
        },
        "mergeClaim": {
          "const": "not-claimed"
        },
        "buildActionClaim": {
          "const": "not-claimed"
        },
        "releaseClaim": {
          "const": "not-claimed"
        },
        "settingsClaim": {
          "const": "not-claimed"
        },
        "riskAcceptanceClaim": {
          "const": "not-claimed"
        },
        "approvalClaim": {
          "const": "not-claimed"
        },
        "externalCommunicationClaim": {
          "const": "dispatch-receipts-only"
        }
      }
    }
  }
