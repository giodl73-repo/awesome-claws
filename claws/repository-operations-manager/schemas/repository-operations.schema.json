        "id": {
          "$ref": "#/$defs/id"
        },
        "entityRef": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "opened",
            "updated",
            "review-changed",
            "check-changed",
            "merged",
            "closed",
            "build-changed",
            "release-changed",
            "removed"
          ]
        },
        "beforeRevision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "afterRevision": {
          "$ref": "#/$defs/nullableRevision"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "subjectRefs",
        "ownerRef",
        "evidenceRefs",
        "state",
        "resolutionEvidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "stale-review",
            "changes-requested-review",
            "failed-check",
            "failed-build",
            "missing-artifact",
            "failed-artifact",
            "cross-repository-ordering",
            "partial-release",
            "failed-release",
            "rolled-back-release",
            "superseded-release",
            "approval-required",
            "approval-rejected",
            "approval-change-requested",
            "approval-expired",
            "approval-no-response",
            "missing-evidence"
          ]
        },
        "subjectRefs": {
          "$ref": "#/$defs/idList"
        },
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/idList"
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolutionEvidenceRef": {
          "$ref": "#/$defs/nullableId"
        },
        "missingEvidenceHistory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkpointRef",
            "subjectRef",
            "priorRevision",
            "priorState",
            "closureEvidenceRef"
          ],
          "properties": {
            "checkpointRef": {
              "$ref": "#/$defs/id"
            },
            "subjectRef": {
              "$ref": "#/$defs/id"
            },
            "priorRevision": {
              "$ref": "#/$defs/digest"
            },
            "priorState": {
              "enum": [
                "missing",
                "pending"
              ]
            },
            "closureEvidenceRef": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "missing-evidence"
              },
              "state": {
                "const": "resolved"
              }
            },
            "required": [
              "category",
              "state"
            ]
          },
          "then": {
            "properties": {
              "missingEvidenceHistory": {
                "type": "object"
              }
            },
            "required": [
              "missingEvidenceHistory"
            ]
          },
          "else": {
            "not": {
              "required": [
                "missingEvidenceHistory"
              ]
            }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolioState",
        "repositoryStates",
        "releaseTrainStates",
        "blockerRefs"
