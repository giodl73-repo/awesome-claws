        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "custodianRef": {
          "$ref": "#/$defs/id"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/escalationRoute"
          }
        }
      }
    },
    "escalationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "policyRevision",
        "destination",
        "allowedCategory",
        "recipientRefs",
        "authorizedByRef",
