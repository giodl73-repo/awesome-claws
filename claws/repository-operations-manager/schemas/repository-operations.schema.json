        "branchChangeClaim",
        "mergeClaim",
        "buildActionClaim",
        "releaseClaim",
        "settingsClaim",
        "riskAcceptanceClaim",
        "approvalClaim",
        "externalCommunicationClaim"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "blocked",
            "ready-for-owner-review"
          ]
