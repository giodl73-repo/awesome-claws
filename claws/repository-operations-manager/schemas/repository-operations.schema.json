          "$ref": "#/$defs/timestamp"
        },
        "authorRef": {
          "$ref": "#/$defs/id"
        },
        "subjectRefs": {
          "$ref": "#/$defs/idList"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
