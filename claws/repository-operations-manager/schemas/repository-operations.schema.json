            "risk-decision",
            "change-request"
          ]
        },
        "recipientRefs": {
          "$ref": "#/$defs/idList"
        },
        "authorizedByRef": {
          "$ref": "#/$defs/id"
        },
        "authorizationEvidenceRef": {
          "$ref": "#/$defs/id"
        },
        "templateRevision": {
          "type": "string",
          "minLength": 1
        },
        "deadlineHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "targetRef",
        "targetRevision",
        "evidenceRef",
        "evidenceRevision",
        "recipientRef",
        "routeRef",
        "deadline",
        "dedupeKey",
        "state",
        "dispatch",
        "responseRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "merge-approval",
            "release-approval",
            "risk-decision",
            "change-request"
          ]
        },
        "targetRef": {
          "$ref": "#/$defs/id"
        },
        "targetRevision": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        },
        "evidenceRevision": {
          "type": "string",
          "minLength": 1
        },
        "recipientRef": {
          "$ref": "#/$defs/id"
        },
        "routeRef": {
          "$ref": "#/$defs/id"
        },
        "deadline": {
          "$ref": "#/$defs/timestamp"
        },
        "dedupeKey": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "dispatched",
            "approved",
            "rejected",
            "change-requested",
            "expired",
            "no-response"
          ]
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "responseRef": {
          "$ref": "#/$defs/nullableId"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerMessageId",
        "dispatchedAt",
        "destination",
        "templateRevision",
        "receiptEvidenceRef"
      ],
      "properties": {
        "providerMessageId": {
          "type": "string",
          "minLength": 1
        },
        "dispatchedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "destination": {
          "type": "string",
          "pattern": "^controlled://"
        },
        "templateRevision": {
          "type": "string",
          "minLength": 1
        },
        "receiptEvidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requestRef",
        "requestDedupeKey",
        "targetRef",
        "targetRevision",
        "evidenceRevision",
        "authorRef",
        "outcome",
        "authoredAt",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
