        "requestDedupeKey": {
          "$ref": "#/$defs/digest"
        },
        "targetRef": {
          "$ref": "#/$defs/id"
        },
        "targetRevision": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRevision": {
          "type": "string",
          "minLength": 1
        },
        "authorRef": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected",
            "change-requested",
            "expired",
            "no-response"
          ]
        },
        "authoredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "human-decision"
            },
            "outcome": {
              "enum": [
                "approved",
                "rejected",
                "change-requested"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "deadline-observation"
            },
            "outcome": {
              "enum": [
                "expired",
                "no-response"
              ]
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sourceRef",
        "sourceRecordDigest",
        "observedAt",
        "authorRef",
        "subjectRefs",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
