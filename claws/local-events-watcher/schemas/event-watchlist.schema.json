{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/local-events-watcher/event-watchlist.schema.json",
  "title": "Local Events Watcher Event Watchlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plan", "sources", "venues", "constraints", "events", "ticketing", "conflicts", "watchlist", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.eventWatchlist.v1" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf", "dateWindow", "region", "audience"],
      "properties": {
        "id": { "type": "string", "pattern": "^event-plan-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "dateWindow": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["official-event-page", "ticketing-page", "venue-page", "calendar-listing", "community-feed", "school-notice", "map-listing", "accessibility-note", "owner-note"] },
          "authority": { "enum": ["organizer", "ticketing-platform", "venue", "calendar-provider", "community-source", "school-or-club", "map-provider", "accessibility-source", "user-supplied"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "stale", "missing", "conflicting"] },
          "privacy": { "enum": ["normal", "location-sensitive", "minor-sensitive", "accessibility-sensitive", "group-sensitive", "care-sensitive"] }
        }
      }
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "neighborhood", "distanceState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^venue-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["theater", "club", "arena", "park", "school", "community-space", "museum", "restaurant", "other"] },
          "neighborhood": { "type": "string", "minLength": 1 },
          "distanceState": { "enum": ["inside-target-area", "nearby", "travel-needed", "unknown"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "required", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^constraint-[a-z0-9-]+$" },
          "kind": { "enum": ["date-window", "schedule-conflict", "accessibility", "age-fit", "noise", "price", "distance", "interest", "transport", "privacy"] },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "privacy": { "enum": ["normal", "location-sensitive", "minor-sensitive", "accessibility-sensitive", "group-sensitive", "care-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "startsAt", "venueRef", "ageFit", "accessibilityState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["concert", "theater", "sports", "community", "school", "family", "festival", "class", "other"] },
          "startsAt": { "type": "string", "format": "date-time" },
          "venueRef": { "type": "string", "minLength": 1 },
          "ageFit": { "enum": ["supported", "possible", "unknown", "not-suitable"] },
          "accessibilityState": { "enum": ["supported", "possible", "unknown", "not-supported"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "ticketing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventRef", "availabilityState", "priceState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^ticketing-[a-z0-9-]+$" },
          "eventRef": { "type": "string", "minLength": 1 },
          "availabilityState": { "enum": ["available", "limited", "waitlist", "sold-out", "free", "unknown"] },
          "priceState": { "enum": ["inside-budget", "above-budget", "free", "unknown"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventRef", "state", "reason", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^conflict-[a-z0-9-]+$" },
          "eventRef": { "type": "string", "minLength": 1 },
          "state": { "enum": ["clear", "possible", "conflicts", "unknown"] },
          "reason": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventRef", "ticketingRef", "conflictRef", "rank", "fit", "fitReason", "constraintRefs", "state", "blockedReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^watch-[a-z0-9-]+$" },
          "eventRef": { "type": "string", "minLength": 1 },
          "ticketingRef": { "type": "string", "minLength": 1 },
          "conflictRef": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["strong", "possible", "blocked"] },
          "fitReason": { "type": "string", "minLength": 1 },
          "constraintRefs": { "$ref": "#/$defs/refs" },
          "state": { "enum": ["recommended", "review-needed", "blocked"] },
          "blockedReason": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "eventRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "eventRefs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["buy-ticket", "join-waitlist", "rsvp", "contact-venue", "message-attendees", "arrange-ride", "pay-event", "modify-calendar", "share-private-location", "post-publicly", "claim-age-safety-certainty"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["draft", "ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["buy-ticket", "join-waitlist", "rsvp", "contact-venue", "message-attendees", "arrange-ride", "pay-event", "modify-calendar", "share-private-location", "post-publicly", "claim-age-safety-certainty"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
