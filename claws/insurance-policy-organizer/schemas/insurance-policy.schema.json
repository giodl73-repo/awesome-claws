{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/insurance-policy-organizer/insurance-policy.schema.json",
  "title": "Insurance Policy Organizer Binder",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "binder", "sources", "policies", "coverageItems", "assets", "premiumItems", "claimReadiness", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.insurancePolicy.v1" },
    "binder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf", "purpose", "privacyMode"],
      "properties": {
        "id": { "type": "string", "pattern": "^insurance-binder-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "purpose": { "type": "string", "minLength": 1 },
        "privacyMode": { "enum": ["owner-only", "household-safe", "redacted"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["policy-document", "declarations-page", "endorsement", "premium-notice", "renewal-notice", "claim-correspondence", "receipt", "asset-inventory", "owner-note", "agent-note", "carrier-page"] },
          "authority": { "enum": ["owner", "carrier", "agent", "merchant", "receipt", "unknown"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "recent", "stale", "unknown", "conflicting"] },
          "privacy": { "enum": ["normal", "private", "address-sensitive", "financial-sensitive", "medical-sensitive", "asset-sensitive", "claim-sensitive"] }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyType", "carrier", "policyNumberState", "status", "effectiveDate", "renewalDate", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^policy-[a-z0-9-]+$" },
          "policyType": { "enum": ["home", "renters", "auto", "health", "life", "disability", "umbrella", "pet", "travel", "other"] },
          "carrier": { "type": "string", "minLength": 1 },
          "policyNumberState": { "enum": ["provided", "redacted", "missing", "conflicting"] },
          "status": { "enum": ["active", "renewal-pending", "expired-risk", "unknown", "conflicting"] },
          "effectiveDate": { "type": ["string", "null"], "format": "date-time" },
          "renewalDate": { "type": ["string", "null"], "format": "date-time" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "coverageItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyRef", "label", "coverageState", "limitState", "deductibleState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^coverage-[a-z0-9-]+$" },
          "policyRef": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "coverageState": { "enum": ["supported", "possible", "unknown", "excluded", "conflicting"] },
          "limitState": { "enum": ["supported", "unknown", "conflicting", "not-applicable"] },
          "deductibleState": { "enum": ["supported", "unknown", "conflicting", "not-applicable"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^asset-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["home", "vehicle", "person", "pet", "trip", "item", "other"] },
          "privacy": { "enum": ["normal", "private", "address-sensitive", "financial-sensitive", "medical-sensitive", "asset-sensitive", "claim-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "premiumItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyRef", "amountState", "dueDateState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^premium-[a-z0-9-]+$" },
          "policyRef": { "type": "string", "minLength": 1 },
          "amountState": { "enum": ["supported", "estimated", "unknown", "conflicting"] },
          "dueDateState": { "enum": ["supported", "unknown", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "claimReadiness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policyRef", "assetRefs", "evidenceRefs", "state", "blockedReason", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim-readiness-[a-z0-9-]+$" },
          "policyRef": { "type": "string", "minLength": 1 },
          "assetRefs": { "$ref": "#/$defs/refs" },
          "evidenceRefs": { "$ref": "#/$defs/refs" },
          "state": { "enum": ["ready-for-owner-review", "needs-evidence", "blocked", "unknown", "conflicting"] },
          "blockedReason": { "type": ["string", "null"], "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "refs", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "$ref": "#/$defs/refs" },
          "owner": { "enum": ["owner", "carrier", "agent", "licensed-professional", "unknown"] }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prohibitedAction" }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary", "reviewQuestionRefs", "prohibitedActions", "nextOwner"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked-on-evidence", "blocked-on-approval"] },
        "summary": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": { "$ref": "#/$defs/refs" },
        "prohibitedActions": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prohibitedAction" }
        },
        "nextOwner": { "enum": ["owner", "carrier", "agent", "licensed-professional"] }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibitedAction": {
      "enum": ["file-claim", "change-coverage", "cancel-policy", "renew-policy", "pay-premium", "contact-carrier", "contact-agent", "edit-calendar", "share-address", "share-policy-number", "upload-documents", "give-legal-advice", "give-insurance-advice", "estimate-claim-value"]
    }
  }
}
