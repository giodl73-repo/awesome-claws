{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/life-timeline-keeper/life-timeline.schema.json",
  "title": "Life Timeline Keeper Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timeline", "sources", "people", "places", "events", "pointers", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.lifeTimeline.v1" },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf", "purpose", "privacyMode"],
      "properties": {
        "id": { "type": "string", "pattern": "^timeline-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "purpose": { "type": "string", "minLength": 1 },
        "privacyMode": { "enum": ["owner-only", "family-review", "redacted"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness", "privacy"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["owner-memory", "journal-note", "photo-list", "video-list", "calendar-export", "travel-record", "school-record", "certificate", "message-export", "document-pointer", "archive-reference", "family-note"] },
          "authority": { "enum": ["user-supplied", "family-supplied", "document-supplied", "calendar-export", "archive-export"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "stale", "missing", "conflicting"] },
          "privacy": { "enum": ["normal", "person-sensitive", "location-sensitive", "document-sensitive", "memory-sensitive", "minor-sensitive"] }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^person-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "role": { "enum": ["owner", "family", "friend", "caregiver", "classmate", "unknown"] },
          "privacy": { "enum": ["normal", "person-sensitive", "minor-sensitive", "relationship-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^place-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "privacy": { "enum": ["normal", "location-sensitive", "home-sensitive", "school-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "date", "dateEnd", "dateState", "certainty", "privacy", "personRefs", "placeRefs", "pointerRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["trip", "move", "milestone", "family-event", "school", "achievement", "documented-event", "memory"] },
          "date": { "type": ["string", "null"], "format": "date" },
          "dateEnd": { "type": ["string", "null"], "format": "date" },
          "dateState": { "enum": ["exact", "range", "approximate", "missing", "conflicting"] },
          "certainty": { "enum": ["supported", "owner-memory", "possible", "conflicting", "unsupported"] },
          "privacy": { "enum": ["normal", "person-sensitive", "location-sensitive", "document-sensitive", "memory-sensitive", "minor-sensitive"] },
          "personRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "placeRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "pointerRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^pointer-[a-z0-9-]+$" },
          "kind": { "enum": ["photo", "video", "document", "calendar", "message", "archive-item"] },
          "label": { "type": "string", "minLength": 1 },
          "privacy": { "enum": ["normal", "person-sensitive", "location-sensitive", "document-sensitive", "memory-sensitive", "minor-sensitive"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "refs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "enum": ["post-publicly", "share-timeline", "identify-faces", "tag-people", "contact-people", "edit-album", "move-files", "delete-files", "publish", "change-permissions", "legal-claim", "medical-claim", "genealogical-claim", "sensitive-disclosure"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["draft", "ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": { "$ref": "#/$defs/refs" },
        "prohibitedActions": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": { "enum": ["post-publicly", "share-timeline", "identify-faces", "tag-people", "contact-people", "edit-album", "move-files", "delete-files", "publish", "change-permissions", "legal-claim", "medical-claim", "genealogical-claim", "sensitive-disclosure"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
