{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "validatorArtifactDigest",
    "sourceArtifacts",
    "futureArtifacts",
    "complianceArtifact",
    "contractArtifact",
    "execution",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.futureThirdPartyReviewAnalogueGraph.v1"
    },
    "graphId": {
      "$ref": "#/$defs/id"
    },
    "validatorArtifactDigest": {
      "$ref": "#/$defs/digest"
    },
    "sourceArtifacts": {
      "$ref": "#/$defs/sourceArtifacts"
    },
    "futureArtifacts": {
      "$ref": "#/$defs/sourceArtifacts"
    },
    "complianceArtifact": {
      "$ref": "#/$defs/complianceArtifact"
    },
    "contractArtifact": {
      "$ref": "#/$defs/contractArtifact"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "sourceArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complianceGraphDigest",
        "contractGraphDigest"
      ],
      "properties": {
        "complianceGraphDigest": {
          "$ref": "#/$defs/digest"
        },
        "contractGraphDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "complianceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "applicabilityRecords",
        "expiryRecords"
      ],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "requirementCatalogRevision": { "$ref": "#/$defs/digest" },
        "cellIndexRevision": { "$ref": "#/$defs/digest" },
        "freshnessRuleRevision": { "$ref": "#/$defs/digest" },
        "applicabilityRecords": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/applicability" }
        },
        "expiryRecords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/expiry" }
        }
      }
    },
    "contractArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "reopeningRecords"
      ],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "requirementCatalogRevision": { "$ref": "#/$defs/digest" },
        "cellIndexRevision": { "$ref": "#/$defs/digest" },
        "freshnessRuleRevision": { "$ref": "#/$defs/digest" },
        "reopeningRecords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/reopening" }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellRef",
        "vendorServiceRef",
        "requirementRef",
        "ownerRef",
        "declarationEvidenceRef",
        "cellDigest"
      ],
      "properties": {
        "cellRef": { "$ref": "#/$defs/id" },
        "vendorServiceRef": { "$ref": "#/$defs/id" },
        "requirementRef": { "$ref": "#/$defs/id" },
        "ownerRef": { "$ref": "#/$defs/id" },
        "declarationEvidenceRef": { "$ref": "#/$defs/id" },
        "cellDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "validUntil",
        "maxAgeDays",
        "effectiveExpiresAt",
        "state"
      ],
      "properties": {
        "evidenceRef": { "$ref": "#/$defs/id" },
        "validUntil": { "$ref": "#/$defs/timestamp" },
        "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 730 },
        "effectiveExpiresAt": { "$ref": "#/$defs/timestamp" },
        "state": { "enum": ["current", "expired"] }
      }
    },
    "reopening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellRef",
        "predecessorDecisionRef",
        "decisionType",
        "expiredEvidenceRefs"
      ],
      "properties": {
        "cellRef": { "$ref": "#/$defs/id" },
        "predecessorDecisionRef": { "$ref": "#/$defs/id" },
        "decisionType": { "const": "evidence-expired-reopened" },
        "expiredEvidenceRefs": { "$ref": "#/$defs/idList" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validatorArtifactDigest",
        "inputGraphDigest",
        "outputGraphDigest",
        "executedAt"
      ],
      "properties": {
        "validatorArtifactDigest": { "$ref": "#/$defs/digest" },
        "inputGraphDigest": { "$ref": "#/$defs/digest" },
        "outputGraphDigest": { "$ref": "#/$defs/digest" },
        "executedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRef",
        "signingKeyId",
        "issuedAt",
        "signature"
      ],
      "properties": {
        "ownerRef": { "$ref": "#/$defs/id" },
        "signingKeyId": { "$ref": "#/$defs/id" },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
