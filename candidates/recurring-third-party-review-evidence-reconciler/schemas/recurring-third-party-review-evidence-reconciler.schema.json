{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/recurring-third-party-review-evidence-reconciler.schema.json",
  "title": "Recurring Third-Party Review Evidence Reconciler bounded candidate slice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "requirementCatalog",
    "vendorServices",
    "subprocessors",
    "freshnessRules",
    "principals",
    "cycle",
    "predecessorCycle",
    "evidence",
    "decisions",
    "remediations",
    "exceptions",
    "riskAcceptanceAttempts",
    "ownerManifests",
    "sourceAuthority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.recurringThirdPartyReviewEvidenceReconcilerSlice.v1"
    },
    "artifactId": {
      "$ref": "#/$defs/id"
    },
    "requirementCatalog": {
      "$ref": "#/$defs/requirementCatalog"
    },
    "vendorServices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/vendorService"
      }
    },
    "subprocessors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/subprocessor"
      }
    },
    "freshnessRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/freshnessRule"
      }
    },
    "principals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/principal"
      }
    },
    "cycle": {
      "$ref": "#/$defs/cycle"
    },
    "predecessorCycle": {
      "$ref": "#/$defs/predecessorCycle"
    },
    "evidence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "remediations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/remediation"
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "riskAcceptanceAttempts": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/riskAcceptanceAttempt"
      }
    },
    "ownerManifests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/ownerManifest"
      }
    },
    "sourceAuthority": {
      "$ref": "#/$defs/sourceAuthority"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "controlledRef": {
      "type": "string",
      "pattern": "^controlled://[^\\s]+$",
      "maxLength": 500
    },
    "sourceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/controlledRef"
        },
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 500
        }
      ]
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nullableId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "role",
        "humanIdentityRef",
        "authoritySourceRef",
        "authorityObservedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "const": "human"
        },
        "role": {
          "enum": [
            "review-program-owner",
            "requirement-catalog-owner",
            "vendor-service-owner",
            "evidence-custodian",
            "reviewer",
            "remediation-owner",
            "exception-authority"
          ]
        },
        "humanIdentityRef": {
          "$ref": "#/$defs/controlledRef"
        },
        "authoritySourceRef": {
          "$ref": "#/$defs/controlledRef"
        },
        "authorityObservedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "requirementCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "revision",
        "approvedByRef",
        "approvedAt",
        "requirements",
        "cells"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "revision": {
          "$ref": "#/$defs/digest"
        },
        "approvedByRef": {
          "$ref": "#/$defs/id"
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "requirements": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "cells": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/requirementCell"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "requiredEvidenceKind",
        "freshnessRuleRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "requiredEvidenceKind": {
          "enum": [
            "assurance-report",
            "security-questionnaire",
            "subprocessor-disclosure",
            "continuity-test"
          ]
        },
        "freshnessRuleRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "requirementCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vendorServiceRef",
        "requirementRef",
        "ownerRef",
        "applicability",
        "declaredAt",
        "declarationEvidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "vendorServiceRef": {
          "$ref": "#/$defs/id"
        },
        "requirementRef": {
          "$ref": "#/$defs/id"
        },
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "applicability": {
          "const": "owner-declared-applicable"
        },
        "declaredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "declarationEvidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "vendorService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "vendorId",
        "vendorName",
        "serviceId",
        "serviceName",
        "ownerRef",
        "subprocessorRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "vendorId": {
          "$ref": "#/$defs/id"
        },
        "vendorName": {
          "$ref": "#/$defs/text"
        },
        "serviceId": {
          "$ref": "#/$defs/id"
        },
        "serviceName": {
          "$ref": "#/$defs/text"
        },
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "subprocessorRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "subprocessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "serviceRefs",
        "declarationEvidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "serviceRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "declarationEvidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "freshnessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidenceKind",
        "maxAgeDays",
        "explicitValidUntilRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "evidenceKind": {
          "enum": [
            "assurance-report",
            "security-questionnaire",
            "subprocessor-disclosure",
            "continuity-test",
            "applicability-declaration",
            "cycle-approval",
            "remediation-record",
            "exception-approval"
          ]
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730
        },
        "explicitValidUntilRequired": {
          "type": "boolean"
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "requirementCatalogRef",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "predecessorCycleRef",
        "opensAt",
        "closesAt",
        "approvedByRef",
        "approvedAt",
        "approvalEvidenceRef",
        "handoffOwnerRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "approved"
        },
        "requirementCatalogRef": {
          "$ref": "#/$defs/id"
        },
        "requirementCatalogRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellIndexRevision": {
          "$ref": "#/$defs/digest"
        },
        "freshnessRuleRevision": {
          "$ref": "#/$defs/digest"
        },
        "predecessorCycleRef": {
          "$ref": "#/$defs/id"
        },
        "opensAt": {
          "$ref": "#/$defs/timestamp"
        },
        "closesAt": {
          "$ref": "#/$defs/timestamp"
        },
        "approvedByRef": {
          "$ref": "#/$defs/id"
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "approvalEvidenceRef": {
          "$ref": "#/$defs/id"
        },
        "handoffOwnerRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "predecessorCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementCatalogRef",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "closedAt",
        "decisions",
        "artifactDigest",
        "sourceAuthority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "requirementCatalogRef": {
          "$ref": "#/$defs/id"
        },
        "requirementCatalogRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellIndexRevision": {
          "$ref": "#/$defs/digest"
        },
        "freshnessRuleRevision": {
          "$ref": "#/$defs/digest"
        },
        "closedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "decisions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/predecessorDecision"
          }
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceAuthority": {
          "$ref": "#/$defs/sourceAuthority"
        }
      }
    },
    "predecessorDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cellRef",
        "decisionType",
        "decidedByRef",
        "decidedAt",
        "evidenceRefs",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "cellDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cellRef": {
          "$ref": "#/$defs/id"
        },
        "decisionType": {
          "enum": [
            "evidence-confirmed",
            "exception-recorded"
          ]
        },
        "decidedByRef": {
          "$ref": "#/$defs/id"
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "requirementCatalogRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellIndexRevision": {
          "$ref": "#/$defs/digest"
        },
        "freshnessRuleRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subjectType",
        "subjectRef",
        "cellRefs",
        "sourceClass",
        "sourceRef",
        "sourceVersion",
        "observedAt",
        "validUntil",
        "suppliedByRef",
        "sourceContentDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "assurance-report",
            "security-questionnaire",
            "subprocessor-disclosure",
            "continuity-test",
            "applicability-declaration",
            "cycle-approval",
            "remediation-record",
            "exception-approval"
          ]
        },
        "subjectType": {
          "enum": [
            "requirement-cell",
            "subprocessor",
            "review-cycle",
            "remediation",
            "exception"
          ]
        },
        "subjectRef": {
          "$ref": "#/$defs/id"
        },
        "cellRefs": {
          "$ref": "#/$defs/idList"
        },
        "sourceClass": {
          "enum": [
            "owner-controlled",
            "public-trust"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "sourceVersion": {
          "$ref": "#/$defs/text"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "suppliedByRef": {
          "$ref": "#/$defs/id"
        },
        "sourceContentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cellRef",
        "decisionType",
        "decidedByRef",
        "decidedAt",
        "evidenceRefs",
        "predecessorDecisionRef",
        "remediationRef",
        "exceptionRef",
        "requirementCatalogRevision",
        "cellIndexRevision",
        "freshnessRuleRevision",
        "cellDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cellRef": {
          "$ref": "#/$defs/id"
        },
        "decisionType": {
          "enum": [
            "evidence-confirmed",
            "evidence-expired-reopened",
            "exception-recorded"
          ]
        },
        "decidedByRef": {
          "$ref": "#/$defs/id"
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/nonEmptyIdList"
        },
        "predecessorDecisionRef": {
          "$ref": "#/$defs/id"
        },
        "remediationRef": {
          "$ref": "#/$defs/nullableId"
        },
        "exceptionRef": {
          "$ref": "#/$defs/nullableId"
        },
        "requirementCatalogRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellIndexRevision": {
          "$ref": "#/$defs/digest"
        },
        "freshnessRuleRevision": {
          "$ref": "#/$defs/digest"
        },
        "cellDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cellRef",
        "ownerRef",
        "state",
        "cause",
        "expiredEvidenceRef",
        "predecessorDecisionRef",
        "openedAt",
        "dueAt",
        "evidenceRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cellRef": {
          "$ref": "#/$defs/id"
        },
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "const": "in-progress"
        },
        "cause": {
          "const": "evidence-expired"
        },
        "expiredEvidenceRef": {
          "$ref": "#/$defs/id"
        },
        "predecessorDecisionRef": {
          "$ref": "#/$defs/id"
        },
        "openedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "dueAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cellRef",
        "status",
        "approvedByRef",
        "approvedAt",
        "expiresAt",
        "evidenceRef",
        "scopeDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cellRef": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "active"
        },
        "approvedByRef": {
          "$ref": "#/$defs/id"
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        },
        "scopeDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "riskAcceptanceAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cellRef",
        "attemptedByRef",
        "attemptedAt",
        "assertedAuthoritySourceRef",
        "requestedDisposition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cellRef": {
          "$ref": "#/$defs/id"
        },
        "attemptedByRef": {
          "$ref": "#/$defs/id"
        },
        "attemptedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "assertedAuthoritySourceRef": {
          "$ref": "#/$defs/controlledRef"
        },
        "requestedDisposition": {
          "const": "accept-risk"
        }
      }
    },
    "ownerManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subjectRef",
        "ownerRef",
        "signingKeyId",
        "issuedAt",
        "subjectDigest",
        "cellRefs",
        "cellDigests",
        "signature"
      ],
      "properties": {
        "kind": {
          "enum": [
            "requirement-catalog",
            "vendor-service-applicability"
          ]
        },
        "subjectRef": {
          "$ref": "#/$defs/id"
        },
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "signingKeyId": {
          "$ref": "#/$defs/id"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "cellRefs": {
          "$ref": "#/$defs/idList"
        },
        "cellDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRef",
        "signingKeyId",
        "issuedAt",
        "signature"
      ],
      "properties": {
        "ownerRef": {
          "$ref": "#/$defs/id"
        },
        "signingKeyId": {
          "$ref": "#/$defs/id"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
