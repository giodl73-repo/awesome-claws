{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "validatorId",
    "graphSchemaDigest",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.futureThirdPartyReviewAnalogueValidator.v1"
    },
    "validatorId": {
      "const": "future-third-party-review-analogue-validator"
    },
    "graphSchemaDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rules": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "closed-graph-schema" },
        { "const": "exact-source-artifact-bindings" },
        { "const": "exact-applicability-closure" },
        { "const": "exact-expiry-closure" },
        { "const": "exact-reopening-closure" },
        { "const": "exact-revision-bindings" }
      ],
      "items": false
    }
  }
}
