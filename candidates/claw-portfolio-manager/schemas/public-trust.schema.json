{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-public-trust.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "keys"],
  "properties": {
    "schemaVersion": {"const": "awesomeClaws.clawPortfolioPublicTrust.v2"},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "predecessorRevision",
        "issuedAt",
        "notBefore",
        "expiresAt",
        "keysRoot",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/digest"},
        "predecessorRevision": {"$ref": "#/$defs/digest"},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "notBefore": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/timestamp"},
        "keysRoot": {"$ref": "#/$defs/digest"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "keys": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "principalRef",
          "principalKind",
          "domain",
          "status",
          "activatedAt",
          "revokedAt",
          "publicKeyPem"
        ],
        "properties": {
          "keyId": {"$ref": "#/$defs/id"},
          "principalRef": {"$ref": "#/$defs/id"},
          "principalKind": {"enum": ["human", "system"]},
          "domain": {
            "enum": [
              "catalog",
              "issue",
              "usage",
              "human-grant",
              "classification",
              "composition",
              "run-result",
              "budget"
            ]
          },
          "status": {"enum": ["active", "revoked"]},
          "activatedAt": {"$ref": "#/$defs/timestamp"},
          "revokedAt": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]
          },
          "publicKeyPem": {
            "type": "string",
            "minLength": 100,
            "maxLength": 160,
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+\\n-----END PUBLIC KEY-----\\n$"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": {"const": "external-trust-root-key"},
        "algorithm": {"const": "Ed25519"},
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
