{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-manager/provider-issue-body.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceRefs", "proposalDigest", "request"],
  "properties": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "proposalDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjectRef", "authority"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "provider-issue"},
            "subjectRef": {"$ref": "#/$defs/id"},
            "authority": {"const": "provider-custodian-attestation"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjectRef", "authority"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "continuation-checkpoint"},
            "subjectRef": {"$ref": "#/$defs/id"},
            "authority": {"const": "repository-operations-attestation"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjectRef", "authority"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {
              "enum": ["lifecycle-retirement", "product-decision-required"]
            },
            "subjectRef": {"$ref": "#/$defs/id"},
            "authority": {"const": "catalog-maintainer-decision-reference"}
          }
        }
      ]
    }
  }
}
