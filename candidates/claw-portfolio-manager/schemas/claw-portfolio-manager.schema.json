{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-manager.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "onboarding",
    "principals",
    "grants",
    "providerSnapshot",
    "compositionAssessments",
    "classificationDecisions",
    "budgetLedger",
    "predecessor",
    "usageEnvelopes",
    "authority"
  ],
  "properties": {
    "schemaVersion": {"const": "awesomeClaws.clawPortfolioManagerCandidate.v2"},
    "run": {"$ref": "#/$defs/run"},
    "onboarding": {"$ref": "#/$defs/onboarding"},
    "principals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/principal"}
    },
    "grants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/grant"}
    },
    "providerSnapshot": {"$ref": "#/$defs/providerSnapshot"},
    "compositionAssessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/compositionAssessment"}
    },
    "classificationDecisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/classificationDecision"}
    },
    "budgetLedger": {"$ref": "#/$defs/budgetLedger"},
    "predecessor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/predecessor"}
      ]
    },
    "usageEnvelopes": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/usageEnvelope"}
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "idList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "Ed25519"},
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "admissions",
        "workUnits",
        "costMicros",
        "durationMinutes"
      ],
      "properties": {
        "candidateCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "admissions": {"type": "integer", "minimum": 0, "maximum": 64},
        "workUnits": {"type": "integer", "minimum": 0, "maximum": 100000},
        "costMicros": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "durationMinutes": {"type": "integer", "minimum": 0, "maximum": 525600}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decisionId",
        "mode",
        "asOf",
        "budgetPeriodRef",
        "catalogRevision",
        "portfolioRevision",
        "providerSnapshotRef",
        "providerSnapshotRevision",
        "providerSnapshotCompletenessRoot",
        "packageTreeRef",
        "packageTreeRevision",
        "predecessorResultDigest",
        "predecessorDecisionDigest",
        "predecessorBudgetDigest",
        "idempotencyKey",
        "signedAt",
        "signerRef",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["bootstrap", "adopt", "manage"]},
        "asOf": {"$ref": "#/$defs/timestamp"},
        "budgetPeriodRef": {"$ref": "#/$defs/id"},
        "catalogRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "portfolioRevision": {"$ref": "#/$defs/digest"},
        "providerSnapshotRef": {"$ref": "#/$defs/id"},
        "providerSnapshotRevision": {"$ref": "#/$defs/digest"},
        "providerSnapshotCompletenessRoot": {"$ref": "#/$defs/digest"},
        "packageTreeRef": {"$ref": "#/$defs/id"},
        "packageTreeRevision": {"$ref": "#/$defs/digest"},
        "predecessorResultDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "predecessorDecisionDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "predecessorBudgetDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "idempotencyKey": {"$ref": "#/$defs/digest"},
        "signedAt": {"$ref": "#/$defs/timestamp"},
        "signerRef": {"$ref": "#/$defs/id"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "bootstrapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ownerRef",
        "selectedClawIds",
        "approvedUsageScopes",
        "roles",
        "jobs",
        "processes",
        "capabilities",
        "signedAt",
        "signature"
      ],
      "properties": {
        "mode": {"enum": ["bootstrap", "adopt", "manage"]},
        "ownerRef": {"$ref": "#/$defs/id"},
        "selectedClawIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "approvedUsageScopes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tenantRef", "sourceRef"],
            "properties": {
              "tenantRef": {"$ref": "#/$defs/id"},
              "sourceRef": {
                "type": "string",
                "minLength": 16,
                "maxLength": 512,
                "pattern": "^controlled://"
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/bootstrapEntry"}
        },
        "jobs": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/bootstrapEntry"}
        },
        "processes": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/bootstrapEntry"}
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/bootstrapEntry"}
        },
        "signedAt": {"$ref": "#/$defs/timestamp"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "roles"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["human", "system"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "portfolio-owner",
              "issue-source-custodian",
              "catalog-source-custodian",
              "classifier",
              "composition-reviewer",
              "usage-evidence-issuer",
              "grant-issuer",
              "decision-owner",
              "budget-owner"
            ]
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issuerRef",
        "granteeRef",
        "scope",
        "issueRefs",
        "issuedAt",
        "notBefore",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "issuerRef": {"$ref": "#/$defs/id"},
        "granteeRef": {"$ref": "#/$defs/id"},
        "scope": {
          "enum": [
            "portfolio-review",
            "classification-review",
            "product-decision-review",
            "retirement-review",
            "budget-reservation"
          ]
        },
        "issueRefs": {"$ref": "#/$defs/idList"},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "notBefore": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/timestamp"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name", "nodeId"],
      "properties": {
        "provider": {"const": "github"},
        "owner": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/id"},
        "nodeId": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "byteLength", "digest", "contentBase64"],
      "properties": {
        "mediaType": {"enum": ["text/plain; charset=utf-8", "application/json"]},
        "byteLength": {"type": "integer", "minimum": 0, "maximum": 65536},
        "digest": {"$ref": "#/$defs/digest"},
        "contentBase64": {
          "type": "string",
          "maxLength": 90000,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "providerIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "providerIssueId",
        "number",
        "url",
        "state",
        "revision",
        "etag",
        "title",
        "body",
        "observedAt"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "repository": {"$ref": "#/$defs/repositoryIdentity"},
        "providerIssueId": {"type": "string", "minLength": 1, "maxLength": 128},
        "number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "state": {"enum": ["open", "closed"]},
        "revision": {"$ref": "#/$defs/digest"},
        "etag": {"type": "string", "minLength": 1, "maxLength": 256},
        "title": {"$ref": "#/$defs/bytes"},
        "body": {"$ref": "#/$defs/bytes"},
        "observedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "providerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "repository",
        "custodianRef",
        "capturedAt",
        "issueRefs",
        "issues",
        "completenessRoot",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/digest"},
        "repository": {"$ref": "#/$defs/repositoryIdentity"},
        "custodianRef": {"$ref": "#/$defs/id"},
        "capturedAt": {"$ref": "#/$defs/timestamp"},
        "issueRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/providerIssue"}
        },
        "completenessRoot": {"$ref": "#/$defs/digest"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "compositionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "decisionId",
        "issueRef",
        "issueRevision",
        "graphDigest",
        "requiredPortTypes",
        "requiredOutputType",
        "feasible",
        "proposedClawRefs",
        "lossIds",
        "assessedAt",
        "reviewerRef",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "issueRef": {"$ref": "#/$defs/id"},
        "issueRevision": {"$ref": "#/$defs/digest"},
        "graphDigest": {"$ref": "#/$defs/digest"},
        "requiredPortTypes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "requiredOutputType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "feasible": {"type": "boolean"},
        "proposedClawRefs": {"$ref": "#/$defs/idList"},
        "lossIds": {"$ref": "#/$defs/idList"},
        "assessedAt": {"$ref": "#/$defs/timestamp"},
        "reviewerRef": {"$ref": "#/$defs/id"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "classificationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "decisionId",
        "issueRef",
        "issueRevision",
        "decisionKind",
        "classification",
        "comparison",
        "rationaleCodes",
        "affectedClawIds",
        "compositionAssessmentRef",
        "classifierVersion",
        "classifierCodeDigest",
        "decidedAt",
        "deciderRef",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "issueRef": {"$ref": "#/$defs/id"},
        "issueRevision": {"$ref": "#/$defs/digest"},
        "decisionKind": {"enum": ["typed-classifier", "human-decision"]},
        "classification": {
          "enum": [
            "NEW",
            "IMPROVE",
            "COMPOSE",
            "VARIANT",
            "PRODUCT_DECISION",
            "RETIRE",
            "DUPLICATE",
            "UNSUPPORTED"
          ]
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user",
            "job",
            "workflow",
            "outputs",
            "authority",
            "proof",
            "nearestClawIds"
          ],
          "properties": {
            "user": {"enum": ["same", "different", "not-applicable"]},
            "job": {"enum": ["same", "different", "not-applicable"]},
            "workflow": {"enum": ["same", "different", "not-applicable"]},
            "outputs": {"enum": ["same", "different", "not-applicable"]},
            "authority": {"enum": ["same", "different", "not-applicable"]},
            "proof": {"enum": ["same", "different", "not-applicable"]},
            "nearestClawIds": {"$ref": "#/$defs/idList"}
          }
        },
        "rationaleCodes": {"$ref": "#/$defs/idList"},
        "affectedClawIds": {"$ref": "#/$defs/idList"},
        "compositionAssessmentRef": {"$ref": "#/$defs/id"},
        "classifierVersion": {"const": "claw-portfolio-classifier-v2"},
        "classifierCodeDigest": {"$ref": "#/$defs/digest"},
        "decidedAt": {"$ref": "#/$defs/timestamp"},
        "deciderRef": {"$ref": "#/$defs/id"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "periodId",
        "runId",
        "decisionId",
        "issueRef",
        "issueRevision",
        "classification",
        "idempotencyKey",
        "amounts",
        "state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "periodId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "issueRef": {"$ref": "#/$defs/id"},
        "issueRevision": {"$ref": "#/$defs/digest"},
        "classification": {"enum": ["NEW", "IMPROVE", "COMPOSE"]},
        "idempotencyKey": {"$ref": "#/$defs/digest"},
        "amounts": {"$ref": "#/$defs/amounts"},
        "state": {"enum": ["reserved", "consumed"]}
      }
    },
    "budgetLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "ownerRef",
        "grantRef",
        "period",
        "runId",
        "decisionId",
        "predecessorBudgetDigest",
        "lease",
        "caps",
        "cumulativeBefore",
        "reservations",
        "cumulativeAfter",
        "issuedAt",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/digest"},
        "ownerRef": {"$ref": "#/$defs/id"},
        "grantRef": {"$ref": "#/$defs/id"},
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "startsOn", "endsOn"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "startsOn": {"$ref": "#/$defs/date"},
            "endsOn": {"$ref": "#/$defs/date"}
          }
        },
        "runId": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "predecessorBudgetDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "id",
            "storeRef",
            "periodId",
            "runId",
            "decisionId",
            "expectedCheckpointDigest",
            "state",
            "issuedAt",
            "expiresAt",
            "issuerRef",
            "signature"
          ],
          "properties": {
            "schemaVersion": {
              "const": "awesomeClaws.clawPortfolioBudgetLease.v1"
            },
            "id": {"$ref": "#/$defs/id"},
            "storeRef": {"$ref": "#/$defs/id"},
            "periodId": {"$ref": "#/$defs/id"},
            "runId": {"$ref": "#/$defs/id"},
            "decisionId": {"$ref": "#/$defs/id"},
            "expectedCheckpointDigest": {
              "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
            },
            "state": {"const": "exclusive-cas-granted"},
            "issuedAt": {"$ref": "#/$defs/timestamp"},
            "expiresAt": {"$ref": "#/$defs/timestamp"},
            "issuerRef": {"$ref": "#/$defs/id"},
            "signature": {"$ref": "#/$defs/signature"}
          }
        },
        "caps": {"$ref": "#/$defs/amounts"},
        "cumulativeBefore": {"$ref": "#/$defs/amounts"},
        "reservations": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/reservation"}
        },
        "cumulativeAfter": {"$ref": "#/$defs/amounts"},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capturedAt",
        "runId",
        "decisionId",
        "result",
        "decisions",
        "budget",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "capturedAt": {"$ref": "#/$defs/timestamp"},
        "runId": {"$ref": "#/$defs/id"},
        "decisionId": {"$ref": "#/$defs/id"},
        "result": {"$ref": "#/$defs/bytes"},
        "decisions": {"$ref": "#/$defs/bytes"},
        "budget": {"$ref": "#/$defs/bytes"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "usageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issueRef",
        "revision",
        "tenantRef",
        "sourceRef",
        "observedAt",
        "validUntil",
        "eventCount",
        "successCount",
        "failureCount",
        "minimizedFields"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "issueRef": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/digest"},
        "tenantRef": {"$ref": "#/$defs/id"},
        "sourceRef": {"type": "string", "pattern": "^controlled://"},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "validUntil": {"$ref": "#/$defs/timestamp"},
        "eventCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "successCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "failureCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "minimizedFields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["event-count", "success-count", "failure-count"]}
        }
      }
    },
    "usageEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "issuerRef",
        "tenantRef",
        "sourceRef",
        "issuedAt",
        "records",
        "signature"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/digest"},
        "issuerRef": {"$ref": "#/$defs/id"},
        "tenantRef": {"$ref": "#/$defs/id"},
        "sourceRef": {"type": "string", "pattern": "^controlled://"},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/usageRecord"}
        },
        "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge",
        "publish",
        "budgetIncrease",
        "riskAcceptance",
        "externalMutation",
        "productionClawMutation",
        "sensitivePersonalInference",
        "reseal"
      ],
      "properties": {
        "merge": {"const": false},
        "publish": {"const": false},
        "budgetIncrease": {"const": false},
        "riskAcceptance": {"const": false},
        "externalMutation": {"const": false},
        "productionClawMutation": {"const": false},
        "sensitivePersonalInference": {"const": false},
        "reseal": {"const": false}
      }
    }
  }
}
