{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-package-tree-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "catalogRevision",
    "custodianRef",
    "capturedAt",
    "trees",
    "root",
    "signature"
  ],
  "properties": {
    "schemaVersion": {"const": "awesomeClaws.clawPortfolioPackageTree.v1"},
    "id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/digest"},
    "catalogRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "custodianRef": {"$ref": "#/$defs/id"},
    "capturedAt": {"$ref": "#/$defs/timestamp"},
    "trees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/tree"}
    },
    "root": {"$ref": "#/$defs/digest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "Ed25519"},
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "byteLength", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?:catalog-entry\\.json|(?:sources|claws)/.+)$"
        },
        "mediaType": {
          "enum": [
            "application/json",
            "application/yaml",
            "text/markdown; charset=utf-8",
            "text/html; charset=utf-8",
            "text/plain; charset=utf-8",
            "image/svg+xml",
            "image/png"
          ]
        },
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clawId", "files", "root"],
      "properties": {
        "clawId": {"$ref": "#/$defs/id"},
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/file"}
        },
        "root": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
