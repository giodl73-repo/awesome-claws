{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-manager-source-receipts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "issuerRef",
    "issuedAt",
    "receipts",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.clawPortfolioManagerSourceReceipts.v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "$ref": "#/$defs/digest"
    },
    "issuerRef": {
      "$ref": "#/$defs/id"
    },
    "issuedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "receipts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "algorithm",
        "value"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clawId",
        "sourceRef",
        "mediaType",
        "contentBase64",
        "byteLength",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "clawId": {
          "$ref": "#/$defs/id"
        },
        "sourceRef": {
          "type": "string",
          "pattern": "^catalog\\.json#entries/[a-z][a-z0-9-]+$",
          "maxLength": 160
        },
        "mediaType": {
          "const": "application/vnd.awesome-claws.catalog-entry+json;canonical=v1"
        },
        "contentBase64": {
          "type": "string",
          "minLength": 16,
          "maxLength": 131072,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 98304
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
