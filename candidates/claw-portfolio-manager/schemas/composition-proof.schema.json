{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/candidates/claw-portfolio-manager-composition-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "validatorDigest",
    "artifact",
    "authority",
    "signedAt",
    "signerRef",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.clawPortfolioManagerCompositionProof.v1"
    },
    "graphId": {
      "$ref": "#/$defs/id"
    },
    "validatorDigest": {
      "$ref": "#/$defs/digest"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "bytesBase64"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "bytesBase64": {
          "type": "string",
          "minLength": 16,
          "maxLength": 131072,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventedSemantics",
        "productionMutation",
        "riskAcceptance",
        "ownerDecision"
      ],
      "properties": {
        "inventedSemantics": {
          "const": false
        },
        "productionMutation": {
          "const": false
        },
        "riskAcceptance": {
          "const": false
        },
        "ownerDecision": {
          "const": false
        }
      }
    },
    "signedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "signerRef": {
      "$ref": "#/$defs/id"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "algorithm",
        "value"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/id"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
