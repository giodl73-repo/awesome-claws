{
  "name": "awesome-claws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/materialize-catalog.mjs && node scripts/generate-catalog-chooser.mjs",
    "check": "node --test scripts/*.test.mjs && node scripts/materialize-catalog.mjs --check && node scripts/generate-catalog-chooser.mjs --check && node scripts/validate-catalog.mjs && node scripts/validate-contributions.mjs",
    "create:claw": "node scripts/create-claw.mjs",
    "review:contribution": "node scripts/review-contribution.mjs",
    "screenshots": "node --import tsx scripts/generate-screenshots.mjs",
    "inspect": "node scripts/validate-catalog.mjs --reference",
    "proof:openclaw": "node scripts/prove-openclaw.mjs",
    "proof:portfolio": "node --import tsx scripts/prove-portfolio.mjs",
    "proof:capabilities": "node scripts/prove-capability-matrix.mjs",
    "proof:capstones": "node scripts/prove-capstones.mjs",
    "proof:dependencies": "node scripts/check-dependency-health.mjs",
    "proof:golden": "node scripts/prove-golden-artifact.mjs",
    "proof:experience": "node scripts/prove-experience-assets.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "polish:visual-assets": "node scripts/polish-visual-assets.mjs"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "croner": "^10.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.3",
    "tar": "^7.5.22",
    "tsx": "4.23.1",
    "yaml": "2.9.0",
    "yauzl": "^3.4.0"
  }
}
