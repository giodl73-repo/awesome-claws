{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "operations"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationId",
              "state",
              "evidence"
            ],
            "properties": {
              "operationId": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "tested-synthetic",
                  "blocked",
                  "untested"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "integration",
        "principals",
        "endpoints",
        "operations",
        "contractTests",
        "executionResults",
        "evidence",
        "incompatibilities",
        "readiness",
        "limitations",
        "recommendation",
        "owner",
        "ownerId",
        "handoff"
      ],
      "properties": {
        "schemaVersion": {
          "const": "awesomeClaws.integrationReadiness.v1"
        },
        "integration": {
          "type": "object"
        },
        "principals": {
          "type": "array"
        },
        "endpoints": {
          "type": "array"
        },
        "operations": {
          "type": "array"
        },
        "contractTests": {
          "type": "array"
        },
        "executionResults": {
          "type": "array"
        },
        "evidence": {
          "type": "array"
        },
        "incompatibilities": {
          "type": "array"
        },
        "readiness": {
          "type": "object"
        },
        "limitations": {
          "type": "array"
        },
        "recommendation": {
          "type": [
            "object",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "handoff": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "contractVersion"
        ]
      }
    }
  ]
}
