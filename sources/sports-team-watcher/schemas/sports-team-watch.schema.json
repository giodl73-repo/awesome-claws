{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "watchlist", "sources", "teams", "games", "standings", "rosterNotes", "watchItems", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.sportsTeamWatch.v1" },
    "watchlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "timezone", "asOf"],
      "properties": {
        "id": { "type": "string", "pattern": "^watchlist-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["league-schedule", "league-standings", "team-roster", "team-news", "broadcast-listing", "user-note"] },
          "authority": { "enum": ["official-league", "official-team", "broadcast-partner", "trusted-sports-source", "user-supplied"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] }
        }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "league", "season", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "league": { "type": "string", "minLength": 1 },
          "season": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "teamRef", "kind", "opponent", "startsAt", "status", "score", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^game-[a-z0-9-]+$" },
          "teamRef": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["last", "next", "notable"] },
          "opponent": { "type": "string", "minLength": 1 },
          "startsAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["scheduled", "final", "postponed", "cancelled", "unknown"] },
          "score": { "type": ["string", "null"], "maxLength": 80 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "standings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["teamRef", "summary", "state", "sourceRefs"],
        "properties": {
          "teamRef": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "state": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "rosterNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "teamRef", "subject", "note", "state", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^note-[a-z0-9-]+$" },
          "teamRef": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "state": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "watchItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "teamRef", "title", "whyItMatters", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^watch-[a-z0-9-]+$" },
          "teamRef": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "whyItMatters": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["place-bet", "recommend-odds", "buy-ticket", "join-contest", "send-message", "modify-calendar", "contact-team"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["place-bet", "recommend-odds", "buy-ticket", "join-contest", "send-message", "modify-calendar", "contact-team"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
