{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/conference-opportunities.schema.json",
  "title": "Conference opportunity scout artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scout", "sources", "events", "opportunities", "fitAssessments", "readinessItems", "actionGates", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.conferenceOpportunities.v1" },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "asOf", "timezone"],
      "properties": {
        "id": { "type": "string", "pattern": "^conference-scout-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "provenance", "freshness", "asOf"],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["official-event", "official-cfp", "official-registration", "official-rights", "owner-goals", "owner-availability", "owner-budget", "owner-credentials", "owner-portfolio", "owner-draft", "owner-approval", "owner-action-record"] },
          "label": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "enum": ["official-public", "owner-supplied"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "freshness": { "type": "string", "enum": ["current", "stale", "missing", "conflicting"] },
          "asOf": { "type": "string", "format": "date" }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "startDate", "endDate", "format", "location", "status", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "format": { "type": "string", "enum": ["in-person", "virtual", "hybrid", "unknown"] },
          "location": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["scheduled", "tentative", "cancelled", "completed", "unknown"] },
          "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventRef", "kind", "title", "deadline", "state", "eligibility", "cost", "rights", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^opportunity-[a-z0-9-]+$" },
          "eventRef": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["speaking", "attendance", "sponsorship", "networking"] },
          "title": { "type": "string", "minLength": 1 },
          "deadline": { "type": "string", "format": "date" },
          "state": { "type": "string", "enum": ["current", "stale", "closed", "missing", "conflicting", "owner-review"] },
          "eligibility": { "type": "string", "enum": ["eligible", "ineligible", "unclear", "not-applicable"] },
          "cost": { "type": "string", "minLength": 1 },
          "rights": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "fitAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "opportunityRef", "state", "rationale", "officialSourceRefs", "ownerEvidenceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^fit-[a-z0-9-]+$" },
          "opportunityRef": { "type": "string", "pattern": "^opportunity-[a-z0-9-]+$" },
          "state": { "type": "string", "enum": ["supported", "partial", "unsupported", "blocked"] },
          "rationale": { "type": "string", "minLength": 1 },
          "officialSourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } },
          "ownerEvidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "readinessItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "opportunityRef", "kind", "state", "owner", "evidenceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^readiness-[a-z0-9-]+$" },
          "opportunityRef": { "type": "string", "pattern": "^opportunity-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["abstract", "bio", "portfolio", "eligibility", "budget", "availability", "travel", "accessibility", "rights", "employer-approval"] },
          "state": { "type": "string", "enum": ["ready-for-owner-review", "needs-evidence", "blocked", "not-applicable"] },
          "owner": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "actionGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "opportunityRef", "action", "state", "owner", "evidenceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^gate-[a-z0-9-]+$" },
          "opportunityRef": { "type": "string", "pattern": "^opportunity-[a-z0-9-]+$" },
          "action": { "type": "string", "enum": ["submit-proposal", "register", "book-travel", "buy-ticket", "pay-fee", "contact-organizer", "publish-abstract", "change-calendar", "change-account"] },
          "state": { "type": "string", "enum": ["blocked", "pending-owner-decision", "completed-by-owner"] },
          "owner": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "owner", "refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(source|event|opportunity|fit|readiness|gate|question)-[a-z0-9-]+$" } }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["submit-proposal", "register", "book-travel", "buy-ticket", "pay-fee", "contact-organizer", "publish-abstract", "change-calendar", "change-account", "invent-deadline", "invent-eligibility", "invent-credentials", "invent-cost", "invent-benefit", "invent-organizer-commitment", "legal-advice", "tax-advice", "financial-advice", "visa-advice", "immigration-advice", "employment-advice", "sponsorship-advice", "professional-advice"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"],
      "properties": {
        "state": { "type": "string", "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" } },
        "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
