{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "version", "targetCommit", "checks", "artifacts", "blockers", "decisionState", "communicationState"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "targetCommit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
              "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceItem"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceItem"}},
    "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["summary", "owner", "state"], "properties": {"summary": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "state": {"enum": ["open", "resolved", "accepted"]}}}},
    "decisionState": {"enum": ["not-ready", "ready-for-owner-decision", "approved", "released"]},
    "communicationState": {"enum": ["not-drafted", "draft", "approved", "sent"]}
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "state": {"enum": ["passed", "failed", "blocked", "missing", "waived"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
