  "findings": [
    {
      "id": "finding-focus-visible-checkout",
      "criterionRef": "std-2.4.7",
      "description": "Primary action button on step 2 had no visible focus indicator when navigated by keyboard.",
      "impact": "Keyboard-only users could not tell which control would activate before pressing Enter.",
      "evidenceKind": "automated",
      "assistiveTechnologyUsed": false,
      "sourceRef": "source-automated-scan",
      "severity": "serious",
      "state": "verified"
    },
    {
      "id": "finding-error-announcement-screenreader",
      "criterionRef": "std-4.1.3",
      "description": "Inline validation errors on the payment form were not announced to screen readers.",
      "impact": "Screen-reader users submitted the form without knowing a field was rejected, causing repeated failed attempts.",
      "evidenceKind": "assistive",
      "assistiveTechnologyUsed": true,
      "sourceRef": "source-assistive-session",
      "severity": "critical",
      "state": "open"
    },
    {
      "id": "finding-color-contrast-secondary-button",
      "criterionRef": "std-1.4.3",
      "description": "Secondary 'Save for later' button text has a 3.8:1 contrast ratio against its background.",
      "impact": "Low-vision users may have difficulty reading the secondary action text.",
      "evidenceKind": "manual",
      "assistiveTechnologyUsed": false,
      "sourceRef": "source-manual-audit",
      "severity": "moderate",
      "state": "accepted-risk"
    }
  ],
  "remediations": [
    {
      "id": "remediation-focus-visible",
      "findingRef": "finding-focus-visible-checkout",
