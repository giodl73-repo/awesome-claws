{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collection", "sources", "titles", "availability", "preferences", "shortlist", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.movieStreaming.v1" },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "region", "timezone", "asOf", "services"],
      "properties": {
        "id": { "type": "string", "pattern": "^watchlist-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["title-metadata", "streaming-availability", "content-rating", "household-preference", "watch-history"] },
          "authority": { "enum": ["metadata-provider", "availability-provider", "streaming-service", "ratings-board", "user-supplied", "household-member"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] }
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mediaType", "releaseYear", "runtimeMinutes", "rating", "tasteState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^title-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "mediaType": { "enum": ["movie", "show", "series", "special"] },
          "releaseYear": { "type": ["integer", "null"], "minimum": 1888, "maximum": 2100 },
          "runtimeMinutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 600 },
          "rating": { "type": "string", "minLength": 1 },
          "tasteState": { "enum": ["watchlist", "favorite", "watched", "disliked", "blocked", "unknown"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titleRef", "service", "region", "accessMode", "accountConstraint", "freshness", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^avail-[a-z0-9-]+$" },
          "titleRef": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 2 },
          "accessMode": { "enum": ["included", "rent", "buy", "subscription-required", "unavailable", "unknown"] },
          "accountConstraint": { "enum": ["included-in-owner-plan", "requires-upgrade", "requires-rental", "requires-purchase", "not-in-library", "unknown"] },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "preferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "kind", "value", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^pref-[a-z0-9-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["age-rating-limit", "max-runtime", "genre", "mood", "language", "accessibility", "watched-history"] },
          "value": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "shortlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titleRef", "rank", "fit", "fitReason", "availabilityRef", "preferenceRefs", "state", "blockedReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^pick-[a-z0-9-]+$" },
          "titleRef": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["strong", "possible", "weak", "blocked"] },
          "fitReason": { "type": "string", "minLength": 1 },
          "availabilityRef": { "type": "string", "minLength": 1 },
          "preferenceRefs": { "$ref": "#/$defs/refs" },
          "state": { "enum": ["recommended", "review-needed", "blocked"] },
          "blockedReason": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["rent-title", "buy-title", "subscribe", "cancel-subscription", "publish-rating", "send-message", "modify-calendar", "modify-account", "bypass-restriction"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "enum": ["rent-title", "buy-title", "subscribe", "cancel-subscription", "publish-rating", "send-message", "modify-calendar", "modify-account", "bypass-restriction"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
