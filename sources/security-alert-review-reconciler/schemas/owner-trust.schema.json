{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/security-alert-review-owner-trust.schema.json",
  "title": "Security Alert Review Reconciler owner trust",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awesomeClaws.securityAlertOwnerTrust.v1"
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^(?!.*(?:[Pp]rivate|[Ss]ecret|[Pp]assword|[Tt]oken|[Cc]redential|[Ss]eed|[Pp]kcs|[Pp]em))[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?!.*(?:[Pp]rivate|[Ss]ecret|[Pp]assword|[Tt]oken|[Cc]redential|[Ss]eed|[Pp]kcs|[Pp]em))[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publicKeyDerBase64"
              ],
              "properties": {
                "publicKeyDerBase64": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          }
        }
      }
    }
  }
}