{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/invoice-receivables.schema.json",
  "title": "Invoice and payment follow-up artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledger", "sources", "clients", "invoices", "paymentEvidence", "discrepancies", "followUps", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.invoiceReceivables.v1" },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "asOf", "timezone"],
      "properties": {
        "id": { "type": "string", "pattern": "^invoice-ledger-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "freshness", "privacy", "asOf"],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["invoice", "statement", "contract", "delivery-evidence", "client-note", "payment-record", "credit-note", "dispute-note", "followup-history", "owner-policy", "owner-note"] },
          "label": { "type": "string", "minLength": 1 },
          "freshness": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] },
          "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] },
          "asOf": { "type": "string", "format": "date" }
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "relationship", "privacy", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^client-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "relationship": { "type": "string", "enum": ["active-client", "past-client", "new-client", "agency", "platform", "unknown"] },
          "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "invoices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "clientRef", "invoiceNumber", "issueDate", "dueDate", "currency", "originalAmount", "balanceDue", "status", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^invoice-[a-z0-9-]+$" },
          "clientRef": { "type": "string", "pattern": "^client-[a-z0-9-]+$" },
          "invoiceNumber": { "type": "string", "minLength": 1 },
          "issueDate": { "type": "string", "format": "date" },
          "dueDate": { "type": "string", "format": "date" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "originalAmount": { "type": "number", "minimum": 0 },
          "balanceDue": { "type": "number", "minimum": 0 },
          "status": { "type": "string", "enum": ["open", "paid", "partial", "overdue", "disputed", "stale", "conflicting", "unknown"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "paymentEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invoiceRef", "label", "amount", "currency", "state", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^payment-[a-z0-9-]+$" },
          "invoiceRef": { "type": "string", "pattern": "^invoice-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "state": { "type": "string", "enum": ["confirmed", "pending-owner-review", "partial", "conflicting", "missing"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invoiceRef", "severity", "reason", "refs"],
        "properties": {
          "id": { "type": "string", "pattern": "^discrepancy-[a-z0-9-]+$" },
          "invoiceRef": { "type": "string", "pattern": "^invoice-[a-z0-9-]+$" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|client|invoice|payment|discrepancy|followup|question)-[a-z0-9-]+$" } }
        }
      }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invoiceRef", "label", "state", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^followup-[a-z0-9-]+$" },
          "invoiceRef": { "type": "string", "pattern": "^invoice-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["draft-for-owner-review", "blocked", "sent-by-owner", "needs-evidence"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "refs", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|client|invoice|payment|discrepancy|followup|question)-[a-z0-9-]+$" } },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["issue-invoice", "alter-invoice", "send-reminder", "contact-client", "collect-payment", "initiate-refund", "apply-fee", "write-off-balance", "change-account", "change-payment-instructions", "invent-balance", "invent-due-date", "invent-payment-status", "invent-contract-term", "invent-tax-treatment", "invent-dispute", "accounting-advice", "tax-advice", "legal-advice", "debt-collection-advice", "credit-advice", "financial-advice"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"],
      "properties": {
        "state": { "type": "string", "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewQuestionRefs": { "type": "array", "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" } },
        "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
