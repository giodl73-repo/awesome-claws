{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.dev/schemas/property-insurance-claim-ledger.v1.json",
  "title": "Property insurance claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claim", "authorities", "sources", "events", "propertyUnits", "requirements", "actions", "estimates", "carrierPositions", "payments", "repairRecords", "ownerDecisions", "gaps", "review", "prohibitedActions"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.propertyInsuranceClaim.v1" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerAuthorityRef", "authorizedHelperRefs", "carrierAuthorityRef", "policyRefRedacted", "claimRefRedacted", "jurisdictions", "privacyCeiling", "lossDiscoveredAt", "asOf", "revision", "previousRevisionRef", "eventRefs", "propertyUnitRefs", "requirementRefs", "actionRefs", "estimateRefs", "carrierPositionRefs", "paymentRefs", "repairRecordRefs", "ownerDecisionRefs", "gapRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ownerAuthorityRef": { "$ref": "#/$defs/id" },
        "authorizedHelperRefs": { "$ref": "#/$defs/refArray" },
        "carrierAuthorityRef": { "$ref": "#/$defs/id" },
        "policyRefRedacted": { "$ref": "#/$defs/redactedRef" },
        "claimRefRedacted": { "$ref": "#/$defs/redactedRef" },
        "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 80 } },
        "privacyCeiling": { "enum": ["owner-only", "owner-and-explicit-helper"] },
        "lossDiscoveredAt": { "$ref": "#/$defs/timestamp" },
        "asOf": { "$ref": "#/$defs/timestamp" },
        "revision": { "type": "integer", "minimum": 1 },
        "previousRevisionRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "eventRefs": { "$ref": "#/$defs/refArray" },
        "propertyUnitRefs": { "$ref": "#/$defs/refArray" },
        "requirementRefs": { "$ref": "#/$defs/refArray" },
        "actionRefs": { "$ref": "#/$defs/refArray" },
        "estimateRefs": { "$ref": "#/$defs/refArray" },
        "carrierPositionRefs": { "$ref": "#/$defs/refArray" },
        "paymentRefs": { "$ref": "#/$defs/refArray" },
        "repairRecordRefs": { "$ref": "#/$defs/refArray" },
        "ownerDecisionRefs": { "$ref": "#/$defs/refArray" },
        "gapRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "authorizationSourceRef"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["case-owner", "authorized-helper", "carrier", "adjuster", "qualified-safety-specialist", "repair-provider", "interested-party"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "authorizationSourceRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "subjectRef", "issuerAuthorityRef", "controlledRef", "revision", "issuedAt", "retrievedAt", "jurisdiction", "freshness", "redaction", "containsSecrets"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["owner-observation", "owner-action-note", "owner-decision", "helper-authorization", "policy-document", "official-claim-instruction", "carrier-request", "independent-receipt", "adjuster-observation", "qualified-safety-assessment", "contractor-estimate", "carrier-estimate", "carrier-position", "payment-statement", "payment-receipt", "repair-invoice", "repair-receipt"] },
          "subjectRef": { "$ref": "#/$defs/id" },
          "issuerAuthorityRef": { "$ref": "#/$defs/id" },
          "controlledRef": { "type": "string", "pattern": "^(?:workspace|official|carrier|provider)://[a-z0-9][a-z0-9./_-]*$", "maxLength": 240 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 40 },
          "issuedAt": { "$ref": "#/$defs/timestamp" },
          "retrievedAt": { "$ref": "#/$defs/timestamp" },
          "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 80 },
          "freshness": { "enum": ["current", "superseded", "stale", "unknown"] },
          "redaction": { "const": "minimized-reference-only" },
          "containsSecrets": { "const": false }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "occurredAt", "assertionState", "propertyUnitRefs", "sourceRefs", "coverageDetermination", "causeDetermination", "safetyDetermination"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["owner-loss-observation", "qualified-assessment", "carrier-request", "owner-attempt", "receipt", "carrier-position", "payment-statement", "repair-record"] },
          "occurredAt": { "$ref": "#/$defs/timestamp" },
          "assertionState": { "enum": ["owner-reported", "qualified-observation", "carrier-issued-fact", "official-instruction", "independently-receipted-outcome"] },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "coverageDetermination": { "const": false },
          "causeDetermination": { "const": false },
          "safetyDetermination": { "const": false }
        }
      }
    },
    "propertyUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "redactedIdentifier", "state", "eventRefs", "requirementRefs", "actionRefs", "estimateRefs", "carrierPositionRefs", "paymentRefs", "repairRecordRefs", "ownerDecisionRefs", "gapRefs", "sourceRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["room-surface", "personal-property", "structure", "fixture", "temporary-expense", "other-property"] },
          "redactedIdentifier": { "$ref": "#/$defs/redactedRef" },
          "state": { "enum": ["owner-observed", "qualified-observed", "carrier-positioned", "repaired", "replaced", "unresolved"] },
          "eventRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "requirementRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "actionRefs": { "$ref": "#/$defs/refArray" },
          "estimateRefs": { "$ref": "#/$defs/refArray" },
          "carrierPositionRefs": { "$ref": "#/$defs/refArray" },
          "paymentRefs": { "$ref": "#/$defs/refArray" },
          "repairRecordRefs": { "$ref": "#/$defs/refArray" },
          "ownerDecisionRefs": { "$ref": "#/$defs/refArray" },
          "gapRefs": { "$ref": "#/$defs/refArray" },
          "sourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "propertyUnitRefs", "officialSourceRef", "carrierAuthorityRef", "jurisdiction", "revision", "state", "deadlineAt", "actionRefs", "disclosureClass", "externalExecution"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["claim-filing", "evidence-submission", "inventory", "inspection", "mitigation-record", "estimate", "proof-of-loss", "repair-documentation", "payment-followup", "appeal-or-dispute", "other-requirement"] },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "officialSourceRef": { "$ref": "#/$defs/id" },
          "carrierAuthorityRef": { "$ref": "#/$defs/id" },
          "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 80 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 40 },
          "state": { "enum": ["open", "owner-completed-unacknowledged", "carrier-acknowledged", "carrier-waived", "superseded"] },
          "deadlineAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
          "actionRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "disclosureClass": { "enum": ["none", "minimized-property", "controlled-evidence"] },
          "externalExecution": { "const": "owner-only" }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "propertyUnitRefs", "requirementRef", "ownerAuthorityRef", "state", "attemptedAt", "sourceRefs", "receiptSourceRef", "externalAction", "agentExecuted"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["contact-carrier", "file-claim", "submit-document", "attend-inspection", "perform-mitigation", "request-estimate", "authorize-repair", "purchase-replacement", "accept-or-reject-settlement", "appeal-or-dispute", "payment-followup", "review-evidence"] },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "requirementRef": { "$ref": "#/$defs/id" },
          "ownerAuthorityRef": { "$ref": "#/$defs/id" },
          "state": { "enum": ["planned", "attempted", "failed", "owner-completed", "blocked", "withdrawn", "superseded"] },
          "attemptedAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
          "sourceRefs": { "$ref": "#/$defs/refArray" },
          "receiptSourceRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "externalAction": { "type": "boolean" },
          "agentExecuted": { "const": false }
        }
      }
    },
    "estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "issuerAuthorityRef", "sourceRef", "propertyUnitRefs", "issuedAt", "revision", "status", "amountMinorUnits", "currency", "clawRecommended"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["carrier-estimate", "contractor-estimate"] },
          "issuerAuthorityRef": { "$ref": "#/$defs/id" },
          "sourceRef": { "$ref": "#/$defs/id" },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "issuedAt": { "$ref": "#/$defs/timestamp" },
          "revision": { "type": "string", "minLength": 1, "maxLength": 40 },
          "status": { "enum": ["current", "superseded"] },
          "amountMinorUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "clawRecommended": { "const": false }
        }
      }
    },
    "carrierPositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "carrierAuthorityRef", "sourceRef", "propertyUnitRefs", "issuedAt", "state", "clawEndorsed"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["claim-status", "coverage-position", "deductible-position", "scope-position", "depreciation-or-holdback-position", "payment-position", "document-request", "reservation-of-rights"] },
          "carrierAuthorityRef": { "$ref": "#/$defs/id" },
          "sourceRef": { "$ref": "#/$defs/id" },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "issuedAt": { "$ref": "#/$defs/timestamp" },
          "state": { "enum": ["carrier-pending", "carrier-issued", "carrier-partial", "carrier-denied", "carrier-withdrawn", "superseded"] },
          "clawEndorsed": { "const": false }
        }
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "carrierAuthorityRef", "statementSourceRef", "propertyUnitRefs", "issuedAt", "amountMinorUnits", "currency", "allocations", "state", "receiptSourceRef", "ownerAcceptanceClaim", "settlementClaim"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "carrierAuthorityRef": { "$ref": "#/$defs/id" },
          "statementSourceRef": { "$ref": "#/$defs/id" },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "issuedAt": { "$ref": "#/$defs/timestamp" },
          "amountMinorUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "allocations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["propertyUnitRef", "amountMinorUnits"],
              "properties": {
                "propertyUnitRef": { "$ref": "#/$defs/id" },
                "amountMinorUnits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              }
            }
          },
          "state": { "enum": ["carrier-announced", "owner-confirmed-received", "returned", "held"] },
          "receiptSourceRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "ownerAcceptanceClaim": { "const": false },
          "settlementClaim": { "const": false }
        }
      }
    },
    "repairRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "providerAuthorityRef", "propertyUnitRefs", "sourceRefs", "state", "authorizedActionRef", "completionReceiptSourceRef", "amountMinorUnits", "currency", "agentAuthorized", "repairSufficiencyClaim"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["mitigation", "repair", "replacement"] },
          "providerAuthorityRef": { "$ref": "#/$defs/id" },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "sourceRefs": { "$ref": "#/$defs/refArray" },
          "state": { "enum": ["planned", "owner-authorized", "provider-reported-complete", "owner-verified"] },
          "authorizedActionRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "completionReceiptSourceRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "amountMinorUnits": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
          "currency": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] },
          "agentAuthorized": { "const": false },
          "repairSufficiencyClaim": { "const": false }
        }
      }
    },
    "ownerDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "propertyUnitRefs", "ownerAuthorityRef", "sourceRef", "decidedAt", "agentDecision"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["proceed-with-repair", "accept-payment", "challenge-position", "wait-for-information", "no-action"] },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "ownerAuthorityRef": { "$ref": "#/$defs/id" },
          "sourceRef": { "$ref": "#/$defs/id" },
          "decidedAt": { "$ref": "#/$defs/timestamp" },
          "agentDecision": { "const": false }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "propertyUnitRefs", "relatedRefs", "ownerAuthorityRef", "state", "resolutionSourceRef"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["missing-evidence", "missing-receipt", "scope-difference", "estimate-difference", "carrier-pending", "payment-question", "safety-question", "repair-question", "professional-question", "residual-exposure", "deadline-risk"] },
          "propertyUnitRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "relatedRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
          "ownerAuthorityRef": { "$ref": "#/$defs/id" },
          "state": { "enum": ["open", "owner-accepted", "resolved"] },
          "resolutionSourceRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "nextRevision", "decision", "nextOwnerAuthorityRef", "openGapRefs", "missingReceiptActionRefs", "openRequirementRefs", "pendingCarrierPositionRefs", "announcedPaymentRefs", "unverifiedRepairRecordRefs", "residualPropertyUnitRefs", "closureClaim"],
      "properties": {
        "asOf": { "$ref": "#/$defs/timestamp" },
        "nextRevision": { "type": "integer", "minimum": 2 },
        "decision": { "enum": ["owner-review-required", "ready-for-owner-review"] },
        "nextOwnerAuthorityRef": { "$ref": "#/$defs/id" },
        "openGapRefs": { "$ref": "#/$defs/refArray" },
        "missingReceiptActionRefs": { "$ref": "#/$defs/refArray" },
        "openRequirementRefs": { "$ref": "#/$defs/refArray" },
        "pendingCarrierPositionRefs": { "$ref": "#/$defs/refArray" },
        "announcedPaymentRefs": { "$ref": "#/$defs/refArray" },
        "unverifiedRepairRecordRefs": { "$ref": "#/$defs/refArray" },
        "residualPropertyUnitRefs": { "$ref": "#/$defs/refArray" },
        "closureClaim": { "const": false }
      }
    },
    "prohibitedActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageDetermined", "causeDetermined", "faultDetermined", "liabilityDetermined", "valueDetermined", "depreciationDetermined", "deductibleDetermined", "safetyDetermined", "settlementRecommended", "fraudDetermined", "badFaithDetermined", "adviceGiven", "externalContacted", "claimFiledOrAmended", "evidenceSubmitted", "inspectionOrRepairScheduled", "settlementAcceptedOrRejected", "checkEndorsed", "workAuthorized", "paymentMade", "purchaseMade", "salvageDisposed", "accountOrPolicyChanged", "recoveryDeclared", "claimClosed"],
      "properties": {
        "coverageDetermined": { "const": false },
        "causeDetermined": { "const": false },
        "faultDetermined": { "const": false },
        "liabilityDetermined": { "const": false },
        "valueDetermined": { "const": false },
        "depreciationDetermined": { "const": false },
        "deductibleDetermined": { "const": false },
        "safetyDetermined": { "const": false },
        "settlementRecommended": { "const": false },
        "fraudDetermined": { "const": false },
        "badFaithDetermined": { "const": false },
        "adviceGiven": { "const": false },
        "externalContacted": { "const": false },
        "claimFiledOrAmended": { "const": false },
        "evidenceSubmitted": { "const": false },
        "inspectionOrRepairScheduled": { "const": false },
        "settlementAcceptedOrRejected": { "const": false },
        "checkEndorsed": { "const": false },
        "workAuthorized": { "const": false },
        "paymentMade": { "const": false },
        "purchaseMade": { "const": false },
        "salvageDisposed": { "const": false },
        "accountOrPolicyChanged": { "const": false },
        "recoveryDeclared": { "const": false },
        "claimClosed": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "redactedRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,79}$" },
    "refArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyRefArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
