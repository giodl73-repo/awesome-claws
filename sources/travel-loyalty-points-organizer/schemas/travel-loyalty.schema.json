{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/travel-loyalty.schema.json",
  "title": "Travel loyalty artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "portfolio", "sources", "programs", "balances", "certificates", "benefits", "tripGoals", "redemptionCandidates", "gaps", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.travelLoyalty.v1" },
    "portfolio": { "type": "object", "additionalProperties": false, "required": ["id", "owner", "asOf", "timezone"], "properties": { "id": { "type": "string", "pattern": "^travel-loyalty-[a-z0-9-]+$" }, "owner": { "type": "string", "minLength": 1 }, "asOf": { "type": "string", "format": "date" }, "timezone": { "type": "string", "minLength": 1 } } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "freshness", "privacy", "asOf"], "properties": { "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" }, "kind": { "type": "string", "enum": ["airline-statement", "hotel-statement", "credit-card-statement", "certificate-notice", "benefit-page", "award-search-note", "transfer-page", "fee-note", "trip-goal", "owner-note"] }, "label": { "type": "string", "minLength": 1 }, "freshness": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] }, "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] }, "asOf": { "type": "string", "format": "date" } } } },
    "programs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "accountLabel", "privacy", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "name": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["airline", "hotel", "credit-card", "transferable-points", "other"] }, "accountLabel": { "type": "string", "minLength": 1 }, "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "balances": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "programRef", "amount", "unit", "expiration", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^balance-[a-z0-9-]+$" }, "programRef": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "amount": { "type": ["integer", "null"], "minimum": 0 }, "unit": { "type": "string", "enum": ["points", "miles", "nights", "credits", "unknown"] }, "expiration": { "type": ["string", "null"], "format": "date" }, "state": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "certificates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "programRef", "label", "expiresAt", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^certificate-[a-z0-9-]+$" }, "programRef": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "expiresAt": { "type": ["string", "null"], "format": "date" }, "state": { "type": "string", "enum": ["usable-after-owner-review", "stale", "missing", "conflicting", "expired", "sensitive"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "benefits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "programRef", "label", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^benefit-[a-z0-9-]+$" }, "programRef": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["supported", "needs-owner-review", "stale", "missing", "conflicting"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "tripGoals": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "window", "party", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^trip-[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "window": { "type": "string", "minLength": 1 }, "party": { "type": "string", "minLength": 1 }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "redemptionCandidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "tripRef", "programRef", "balanceRefs", "label", "state", "riskRefs", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^candidate-[a-z0-9-]+$" }, "tripRef": { "type": "string", "pattern": "^trip-[a-z0-9-]+$" }, "programRef": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "balanceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^balance-[a-z0-9-]+$" } }, "label": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["review-candidate", "blocked", "needs-evidence", "owner-declined"] }, "riskRefs": { "type": "array", "items": { "type": "string", "pattern": "^gap-[a-z0-9-]+$" } }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "gaps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "reason", "refs"], "properties": { "id": { "type": "string", "pattern": "^gap-[a-z0-9-]+$" }, "kind": { "type": "string", "enum": ["stale-balance", "missing-balance", "expiration-risk", "certificate-risk", "transfer-risk", "fee-risk", "blackout-risk", "privacy", "conflict"] }, "reason": { "type": "string", "minLength": 1 }, "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|program|balance|certificate|benefit|trip|candidate)-[a-z0-9-]+$" } } } } },
    "reviewQuestions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "question", "reason", "refs", "owner"], "properties": { "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" }, "question": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|program|balance|certificate|benefit|trip|candidate|gap)-[a-z0-9-]+$" } }, "owner": { "type": "string", "minLength": 1 } } } },
    "blockedActions": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string", "enum": ["book-travel", "redeem-award", "transfer-points", "buy-points", "apply-certificate", "change-account", "pay-fee", "contact-provider", "alter-itinerary", "assign-cash-value", "tax-advice", "legal-advice", "financial-advice", "credit-card-advice", "travel-advice", "immigration-advice", "insurance-advice", "loyalty-program-advice"] } },
    "handoff": { "type": "object", "additionalProperties": false, "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"], "properties": { "state": { "type": "string", "enum": ["ready-for-owner-review", "blocked"] }, "owner": { "type": "string", "minLength": 1 }, "reviewQuestionRefs": { "type": "array", "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" } }, "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
  }
}
