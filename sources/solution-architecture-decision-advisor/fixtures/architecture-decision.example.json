  "requirements": [
    {
      "id": "req-throughput",
      "type": "functional",
      "statement": "Sustain 1,200 checkout submissions per second at the approved synthetic peak profile.",
      "priority": "required",
      "ownerRef": "principal-requirements-owner",
      "sourceRef": "controlled://requirements/checkout-revision-03-throughput"
    },
    {
      "id": "req-availability",
      "type": "non-functional",
      "statement": "Support a 99.95 percent monthly availability objective and a 15-minute recovery objective without claiming a guarantee.",
      "priority": "required",
      "ownerRef": "principal-requirements-owner",
      "sourceRef": "controlled://requirements/checkout-revision-03-availability"
    },
    {
      "id": "req-data-residency",
      "type": "non-functional",
      "statement": "Keep payment-token processing and logs within approved United States regions.",
      "priority": "required",
      "ownerRef": "principal-requirements-owner",
      "sourceRef": "controlled://requirements/checkout-revision-03-residency"
    },
    {
      "id": "constraint-annual-cost",
      "type": "constraint",
      "statement": "Keep the modeled annual run-cost range below USD 1.8 million under the supplied demand assumptions.",
      "priority": "required",
      "ownerRef": "principal-requirements-owner",
      "sourceRef": "controlled://requirements/checkout-revision-03-cost"
    },
    {
      "id": "constraint-operations-team",
      "type": "constraint",
      "statement": "Operate with the approved six-person platform team and its documented container skill baseline.",
      "priority": "required",
      "ownerRef": "principal-requirements-owner",
      "sourceRef": "controlled://requirements/checkout-revision-03-operations"
    }
  ],
  "options": [
    {
      "id": "opt-managed-containers",
      "revision": 2,
      "name": "Managed containers",
      "description": "A regional managed-container service with stateless checkout workers, managed queues, and separately owned payment adapters.",
      "state": "candidate",
      "contentDigest": "sha256:6f6cd6637ca7365ff079c11311bbf7378cd2e139ccf32a544532b69dcebdd8aa"
    },
    {
      "id": "opt-serverless-events",
