      "contentDigest": "sha256:a0c8d5a919e7bb12d5490fbbb0b1c72cafda2854d10903ed9bbbf8ddff78c0c0"
    }
  ],
  "criteria": [
    {
      "id": "criterion-requirement-fit",
      "dimension": "requirement-fit",
      "statement": "Coverage of the exact approved functional, non-functional, and constraint universe.",
      "comparisonMethod": "Trace every declared requirement to option-revision evidence and classify coverage using the same four-state rubric.",
      "requiredSpecialistScope": "architecture-analysis"
    },
    {
      "id": "criterion-cost",
      "dimension": "cost",
      "statement": "Modeled annual run-cost range under one demand and pricing assumption set.",
      "comparisonMethod": "Compare low/base/high estimates in USD using the same demand profile, included services, and exclusions.",
      "requiredSpecialistScope": "cost-assessment"
    },
    {
      "id": "criterion-security",
      "dimension": "security",
      "statement": "Trust boundaries, data residency, identity, isolation, and control dependencies.",
      "comparisonMethod": "Apply the same threat-boundary checklist and supplied control revision to each option without certification.",
      "requiredSpecialistScope": "security-assessment"
    },
    {
      "id": "criterion-reliability",
      "dimension": "reliability",
      "statement": "Peak behavior, failure isolation, recovery evidence, and availability-objective fit.",
      "comparisonMethod": "Run the same bounded synthetic load and failure-injection profile and report observed ranges without guarantees.",
      "requiredSpecialistScope": "reliability-assessment"
    },
    {
      "id": "criterion-operability",
      "dimension": "operability",
      "statement": "Day-two ownership, on-call complexity, deployment-unit count, and team skill fit.",
      "comparisonMethod": "Execute the same tabletop scenarios with the approved platform-team roster and score observed operator steps.",
      "requiredSpecialistScope": "operability-assessment"
    }
  ],
