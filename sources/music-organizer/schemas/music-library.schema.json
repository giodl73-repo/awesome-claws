{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "library", "sources", "items", "availability", "preferences", "playlistPlan", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.musicLibrary.v1" },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "region", "timezone", "asOf", "services"],
      "properties": {
        "id": { "type": "string", "pattern": "^music-library-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "authority", "capturedAt", "reference", "freshness"],
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "kind": { "enum": ["music-metadata", "streaming-availability", "library-export", "playlist-export", "listening-history", "owner-preference", "rights-metadata"] },
          "authority": { "enum": ["metadata-provider", "availability-provider", "streaming-service", "local-export", "user-supplied", "rights-database"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "artist", "mediaType", "durationSeconds", "explicitState", "libraryState", "tasteState", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^music-[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "artist": { "type": "string", "minLength": 1 },
          "mediaType": { "enum": ["track", "album", "artist", "playlist", "podcast-episode"] },
          "durationSeconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 },
          "explicitState": { "enum": ["clean", "explicit", "unknown", "not-applicable"] },
          "libraryState": { "enum": ["owned-local", "saved", "liked", "playlist-member", "streamable", "not-in-library", "unknown"] },
          "tasteState": { "enum": ["favorite", "liked", "neutral", "skipped", "disliked", "blocked", "unknown"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemRef", "service", "region", "accessMode", "rightsConstraint", "freshness", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^music-avail-[a-z0-9-]+$" },
          "itemRef": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 2 },
          "accessMode": { "enum": ["owned-local", "included", "subscription-required", "purchase-required", "unavailable", "unknown"] },
          "rightsConstraint": { "enum": ["playable-in-owner-library", "streamable-in-owner-plan", "requires-subscription", "requires-purchase", "region-restricted", "explicit-blocked", "unknown"] },
          "freshness": { "enum": ["current", "delayed", "stale", "missing", "conflicting"] },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "preferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "kind", "value", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^pref-[a-z0-9-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["mood", "activity", "genre", "language", "explicit-limit", "max-duration", "avoid-recent-skips", "dedupe"] },
          "value": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "playlistPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemRef", "position", "fit", "fitReason", "availabilityRef", "preferenceRefs", "state", "blockedReason"],
        "properties": {
          "id": { "type": "string", "pattern": "^pick-[a-z0-9-]+$" },
          "itemRef": { "type": "string", "minLength": 1 },
          "position": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["strong", "possible", "weak", "blocked"] },
          "fitReason": { "type": "string", "minLength": 1 },
          "availabilityRef": { "type": "string", "minLength": 1 },
          "preferenceRefs": { "$ref": "#/$defs/refs" },
          "state": { "enum": ["recommended", "review-needed", "blocked"] },
          "blockedReason": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "itemRefs", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "itemRefs": { "$ref": "#/$defs/refs" },
          "sourceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["buy-track", "subscribe", "cancel-subscription", "modify-account", "publish-playlist", "post-listening-activity", "follow-artist", "download-file", "modify-calendar", "send-message", "bypass-rights"] }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "prohibitedActions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "enum": ["buy-track", "subscribe", "cancel-subscription", "modify-account", "publish-playlist", "post-listening-activity", "follow-artist", "download-file", "modify-calendar", "send-message", "bypass-rights"] }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
