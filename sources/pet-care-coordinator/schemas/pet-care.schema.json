{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pet", "guardian", "evidence", "observations", "assessment", "careCalendar", "monitoring", "providers", "appointment", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.petCare.v1" },
    "pet": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "nameLabel", "species", "ageBand", "weightKg"],
      "properties": {
        "reference": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$", "maxLength": 32 },
        "nameLabel": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$", "maxLength": 32 },
        "species": { "enum": ["dog", "cat", "bird", "rabbit", "reptile", "other"] },
        "ageBand": { "enum": ["juvenile", "adult", "senior", "unknown"] },
        "weightKg": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "guardian": { "$ref": "#/$defs/owner" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "authority", "capturedAt", "reference"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["guardian-report", "photo", "video", "measurement", "veterinary-record", "laboratory-result", "prescription-label", "manufacturer-label", "government-guidance", "provider-info", "integration-approval", "provider-receipt"] },
          "authority": { "enum": ["guardian-supplied", "veterinarian", "veterinary-laboratory", "manufacturer", "government", "service-provider"] },
          "capturedAt": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "subject", "description", "observedAt", "evidenceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "subject": { "enum": ["appetite", "hydration", "elimination", "vomiting", "breathing", "mobility", "behavior", "skin-coat", "weight", "exposure", "other"] },
          "description": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "evidenceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "risks", "action", "rationale", "evidenceRefs"],
      "properties": {
        "level": { "enum": ["emergency", "urgent", "routine", "preventive", "uncertain"] },
        "risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["breathing-distress", "collapse", "uncontrolled-bleeding", "seizure", "toxic-exposure", "medication-error", "foreign-body", "persistent-vomiting", "severe-pain", "rapid-decline", "none"] } },
        "action": { "enum": ["emergency-veterinary", "poison-control", "urgent-veterinary", "routine-veterinary", "preventive-tracking"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "careCalendar": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "dueStart", "dueEnd", "instruction", "executor", "evidenceRefs", "stopConditions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["preventive", "veterinarian-directed-medication", "veterinarian-directed-monitoring", "appointment"] },
          "dueStart": { "type": "string", "format": "date-time" },
          "dueEnd": { "type": "string", "format": "date-time" },
          "instruction": { "type": "string", "minLength": 1 },
          "executor": { "enum": ["guardian", "veterinarian", "none"] },
          "evidenceRefs": { "$ref": "#/$defs/refs" },
          "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "monitoring": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "measure", "dueAt", "observedAt", "state", "evidenceRefs", "successCriteria", "escalationCriteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "measure": { "type": "string", "minLength": 1 },
          "dueAt": { "type": "string", "format": "date-time" },
          "observedAt": { "type": ["string", "null"], "format": "date-time" },
          "state": { "enum": ["planned", "stable", "worsened", "blocked"] },
          "evidenceRefs": { "$ref": "#/$defs/refs" },
          "successCriteria": { "type": "string", "minLength": 1 },
          "escalationCriteria": { "type": "string", "minLength": 1 }
        }
      }
    },
    "providers": { "$ref": "#/$defs/providers" },
    "appointment": { "$ref": "#/$defs/appointment" },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "guardian", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-guardian", "blocked"] },
        "guardian": { "$ref": "#/$defs/owner" },
        "prohibitedActions": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["claim-diagnosis", "prescribe-or-change-dose", "delay-emergency-care", "authorize-treatment-or-service", "submit-payment", "exceed-appointment-scope"] } }
      }
    }
  },
  "$defs": {
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "role"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["human", "team"] }, "role": { "type": "string", "minLength": 1 } }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "specialty", "sourceRef", "qualificationState"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "specialty": { "enum": ["general-veterinary", "emergency-veterinary", "veterinary-specialist", "mobile-veterinary", "animal-poison-control"] },
          "sourceRef": { "type": "string", "minLength": 1 },
          "qualificationState": { "enum": ["guardian-verified", "unverified"] }
        }
      }
    },
    "appointmentPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["providerRef", "specialty", "serviceScope", "startsAt", "timezone", "maxCost", "currency", "maxDeposit", "cancellationTerms", "dataDisclosure"],
      "properties": {
        "providerRef": { "type": "string", "minLength": 1 },
        "specialty": { "type": "string", "minLength": 1 },
        "serviceScope": { "type": "string", "minLength": 1 },
        "startsAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 },
        "maxCost": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maxDeposit": { "type": "number", "minimum": 0 },
        "cancellationTerms": { "type": "string", "minLength": 1 },
        "dataDisclosure": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "appointment": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": { "enum": ["not-requested", "options-ready", "awaiting-approval", "approved", "booked", "blocked"] },
        "plan": { "$ref": "#/$defs/appointmentPlan" },
        "approval": {
          "type": "object", "additionalProperties": false, "required": ["guardian", "planDigest", "approvedAt"],
          "properties": { "guardian": { "$ref": "#/$defs/owner" }, "planDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "approvedAt": { "type": "string", "format": "date-time" } }
        },
        "bookingIntegration": {
          "type": "object", "additionalProperties": false, "required": ["id", "providerRef", "approvalRef", "approvalEvidenceRef", "configuredBy"],
          "properties": { "id": { "type": "string", "pattern": "^approved-integration-[a-z0-9-]+$" }, "providerRef": { "type": "string" }, "approvalRef": { "type": "string", "pattern": "^controlled://[a-z0-9/._-]+$" }, "approvalEvidenceRef": { "type": "string" }, "configuredBy": { "$ref": "#/$defs/owner" } }
        },
        "receipt": {
          "type": "object", "additionalProperties": false, "required": ["planDigest", "integrationId", "providerRef", "confirmationRef", "evidenceRef", "bookedAt"],
          "properties": { "planDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "integrationId": { "type": "string" }, "providerRef": { "type": "string" }, "confirmationRef": { "type": "string", "pattern": "^provider://[a-z0-9/._-]+$" }, "evidenceRef": { "type": "string" }, "bookedAt": { "type": "string", "format": "date-time" } }
        },
        "blockedReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
