{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-claws.local/schemas/networking-followup.schema.json",
  "title": "Professional networking follow-up artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "sources", "contacts", "interactions", "followUps", "introductions", "reminders", "gaps", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.networkingFollowup.v1" },
    "network": { "type": "object", "additionalProperties": false, "required": ["id", "owner", "asOf", "timezone"], "properties": { "id": { "type": "string", "pattern": "^network-[a-z0-9-]+$" }, "owner": { "type": "string", "minLength": 1 }, "asOf": { "type": "string", "format": "date" }, "timezone": { "type": "string", "minLength": 1 } } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "freshness", "privacy", "asOf"], "properties": { "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" }, "kind": { "type": "string", "enum": ["contact-note", "business-card", "event-note", "meeting-summary", "email-snippet", "social-export-note", "introduction-request", "referral-note", "draft", "calendar-note", "owner-note"] }, "label": { "type": "string", "minLength": 1 }, "freshness": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] }, "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] }, "asOf": { "type": "string", "format": "date" } } } },
    "contacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "organization", "relationship", "privacy", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^contact-[a-z0-9-]+$" }, "name": { "type": "string", "minLength": 1 }, "organization": { "type": ["string", "null"] }, "relationship": { "type": "string", "enum": ["new-contact", "known-contact", "mentor", "peer", "recruiter-adjacent", "customer-adjacent", "investor-adjacent", "unknown"] }, "privacy": { "type": "string", "enum": ["owner-only", "redact-before-sharing", "shareable-after-review"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "interactions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "contactRefs", "label", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^interaction-[a-z0-9-]+$" }, "contactRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^contact-[a-z0-9-]+$" } }, "label": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["current", "stale", "missing", "conflicting", "sensitive"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "followUps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "contactRef", "label", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^followup-[a-z0-9-]+$" }, "contactRef": { "type": "string", "pattern": "^contact-[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["draft-for-owner-review", "blocked", "sent-by-owner", "needs-evidence"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "introductions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "contactRefs", "label", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^intro-[a-z0-9-]+$" }, "contactRefs": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^contact-[a-z0-9-]+$" } }, "label": { "type": "string", "minLength": 1 }, "state": { "type": "string", "enum": ["needs-owner-review", "blocked", "made-by-owner", "missing-consent"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "reminders": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "contactRef", "label", "due", "state", "sourceRefs"], "properties": { "id": { "type": "string", "pattern": "^reminder-[a-z0-9-]+$" }, "contactRef": { "type": "string", "pattern": "^contact-[a-z0-9-]+$" }, "label": { "type": "string", "minLength": 1 }, "due": { "type": ["string", "null"], "format": "date" }, "state": { "type": "string", "enum": ["owner-visible", "blocked", "completed-by-owner", "needs-evidence"] }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } } } } },
    "gaps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "reason", "refs"], "properties": { "id": { "type": "string", "pattern": "^gap-[a-z0-9-]+$" }, "kind": { "type": "string", "enum": ["missing-consent", "stale-context", "duplicate-contact", "privacy", "conflict", "referral-risk", "recruiting-risk", "sales-risk"] }, "reason": { "type": "string", "minLength": 1 }, "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|contact|interaction|followup|intro|reminder)-[a-z0-9-]+$" } } } } },
    "reviewQuestions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "question", "reason", "refs", "owner"], "properties": { "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" }, "question": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(source|contact|interaction|followup|intro|reminder|gap)-[a-z0-9-]+$" } }, "owner": { "type": "string", "minLength": 1 } } } },
    "blockedActions": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string", "enum": ["send-message", "make-introduction", "schedule-meeting", "cancel-meeting", "commit-referral", "contact-employer", "contact-prospect", "change-account", "scrape-contacts", "update-crm", "recruiting-action", "sales-outreach", "career-advice", "legal-advice", "financial-advice", "employment-advice", "compensation-advice", "immigration-advice", "privacy-advice", "relationship-advice"] } },
    "handoff": { "type": "object", "additionalProperties": false, "required": ["state", "owner", "reviewQuestionRefs", "prohibitedActions"], "properties": { "state": { "type": "string", "enum": ["ready-for-owner-review", "blocked"] }, "owner": { "type": "string", "minLength": 1 }, "reviewQuestionRefs": { "type": "array", "items": { "type": "string", "pattern": "^question-[a-z0-9-]+$" } }, "prohibitedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
  }
}
