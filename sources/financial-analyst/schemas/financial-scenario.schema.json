{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "asOf", "currency", "sources", "assumptions", "scenarios", "risks", "decisionOwner", "decisionState"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "reference", "observedAt", "state"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["actual", "forecast", "market", "owner-assumption"] },
              "reference": { "type": "string", "minLength": 1 },
              "observedAt": { "type": "string", "format": "date-time" },
              "state": { "enum": ["supported", "limited", "conflicting", "missing"] }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "sourceRefs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "assumptionRefs", "outcomes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "assumptionRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "outcomes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value", "unit"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "value": { "type": "number" },
                    "unit": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "sourceRefs", "scenarioRefs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "scenarioRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "decisionOwner": { "type": "string", "minLength": 1 },
        "decisionState": { "enum": ["analysis-in-progress", "ready-for-owner-review", "approved-by-owner", "rejected-by-owner"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "analysis",
        "principals",
        "inputs",
        "evidence",
        "assumptionRegister",
        "scenarioModels",
        "calculations",
        "outcomes",
        "reconciliations",
        "sensitivityRegister",
        "riskRegister",
        "exceptions",
        "limitations",
        "recommendation",
        "owner",
        "ownerId",
        "handoff"
      ],
      "properties": {
        "schemaVersion": {
          "const": "awesomeClaws.financialAnalysis.v1"
        },
        "analysis": {
          "type": "object"
        },
        "principals": {
          "type": "array"
        },
        "inputs": {
          "type": "array"
        },
        "evidence": {
          "type": "array"
        },
        "assumptionRegister": {
          "type": "array"
        },
        "scenarioModels": {
          "type": "array"
        },
        "calculations": {
          "type": "array"
        },
        "outcomes": {
          "type": "array"
        },
        "reconciliations": {
          "type": "array"
        },
        "sensitivityRegister": {
          "type": "array"
        },
        "riskRegister": {
          "type": "array"
        },
        "exceptions": {
          "type": "array"
        },
        "limitations": {
          "type": "array"
        },
        "recommendation": {
          "type": [
            "object",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "handoff": {
          "type": "object"
        }
      },
      "allOf": [
        { "not": { "required": ["question"] } },
        { "not": { "required": ["asOf"] } },
        { "not": { "required": ["currency"] } },
        { "not": { "required": ["sources"] } },
        { "not": { "required": ["assumptions"] } },
        { "not": { "required": ["scenarios"] } },
        { "not": { "required": ["risks"] } },
        { "not": { "required": ["decisionOwner"] } },
        { "not": { "required": ["decisionState"] } }
      ]
    }
  ]
}
