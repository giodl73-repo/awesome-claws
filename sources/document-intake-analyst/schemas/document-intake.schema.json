{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intake", "sources", "outputs", "findings", "reviewQuestions", "blockedActions", "handoff"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.documentIntake.v1" },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "asOf", "purpose", "processingBoundary", "approvedDestination"],
      "properties": {
        "id": { "type": "string", "pattern": "^intake-[a-z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date-time" },
        "purpose": { "type": "string", "minLength": 1 },
        "processingBoundary": { "enum": ["local-only", "approved-provider"] },
        "approvedDestination": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "format", "checksum", "authority", "classification", "processingAuthorization", "provider", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "format": { "enum": ["pdf", "docx", "pptx", "xlsx", "image", "text", "other"] },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "authority": { "enum": ["owner-supplied", "authorized-export", "approved-shared-folder"] },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
          "processingAuthorization": { "enum": ["local-only", "external-approved", "external-not-approved"] },
          "provider": { "type": ["string", "null"] },
          "state": { "enum": ["converted", "review-needed", "blocked", "excluded"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceRef", "path", "processingMode", "conversionMethod", "conversionState", "originalState", "fidelityState", "reviewState", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^output-[a-z0-9-]+$" },
          "sourceRef": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^outputs/[a-zA-Z0-9._/-]+\\.md$" },
          "processingMode": { "enum": ["local", "external", "none"] },
          "conversionMethod": { "type": "string", "minLength": 1 },
          "conversionState": { "enum": ["complete", "partial", "not-produced"] },
          "originalState": { "enum": ["unchanged", "changed", "unknown"] },
          "fidelityState": { "enum": ["sampled-pass", "sampled-with-exceptions", "unreviewed", "blocked"] },
          "reviewState": { "enum": ["ready", "needs-review", "blocked"] },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outputRef", "sourceRefs", "kind", "severity", "location", "description", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^finding-[a-z0-9-]+$" },
          "outputRef": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" },
          "kind": { "enum": ["ocr-confidence", "table-fidelity", "formula-fidelity", "image-omission", "reading-order", "unsupported-content", "metadata-gap"] },
          "severity": { "enum": ["low", "medium", "high"] },
          "location": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "state": { "enum": ["open", "owner-review", "resolved"] }
        }
      }
    },
    "reviewQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "sourceRefs", "outputRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^question-[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/refs" },
          "outputRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "blockedActions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": ["overwrite-original", "delete-source", "external-processing", "upload-source", "publish-output", "share-output", "change-permissions", "claim-perfect-fidelity"]
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "ownerType", "outputRefs", "blockingFindingRefs", "prohibitedActions"],
      "properties": {
        "state": { "enum": ["ready-for-owner-review", "blocked"] },
        "owner": { "type": "string", "minLength": 1 },
        "ownerType": { "enum": ["human", "team"] },
        "outputRefs": { "$ref": "#/$defs/refs" },
        "blockingFindingRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedActions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["overwrite-original", "delete-source", "external-processing", "upload-source", "publish-output", "share-output", "change-permissions", "claim-perfect-fidelity"]
          }
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
